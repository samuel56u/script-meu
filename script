atualizar_sistema() {
    print_titulo "ATUALIZANDO SISTEMA"
    
    # Método 1: Atualização normal
    print_msg "Atualizando repositórios..."
    if pkg update -y >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Repositórios atualizados"
    else
        print_aviso "Falha na atualização. Tentando método alternativo..."
        pkg update -y --allow-unauthenticated >> "$LOG_SISTEMA" 2>&1
    fi
    
    # Atualiza pacotes
    print_msg "Atualizando pacotes..."
    if pkg upgrade -y >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Pacotes atualizados"
    else
        pkg upgrade -y --allow-unauthenticated >> "$LOG_SISTEMA" 2>&1
    fi
    
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# INSTALAÇÃO DE DEPENDÊNCIAS COM 5 ESTRATÉGIAS
# █████████████████████████████████████████████████████████████████████████████

instalar_dependencias() {
    print_titulo "INSTALANDO DEPENDÊNCIAS"
    
    # Lista completa de dependências
    local DEP_ESSENCIAIS="git wget curl binutils build-essential clang make cmake"
    local DEP_COMPILACAO="autoconf automake libtool pkg-config openssl libcurl jansson"
    local DEP_BIBLIOTECAS="libmicrohttpd libuv hwloc"
    local DEP_FERRAMENTAS="screen tmux nano vim htop bc"
    local DEP_REDE="netcat-openbsd dnsutils traceroute"
    local DEP_OPCIONAIS="neofetch cmatrix figlet toilet cowsay fortune-mod sl hollywood"
    local DEP_TERMUX="termux-api termux-services"
    
    local TODAS_DEP="$DEP_ESSENCIAIS $DEP_COMPILACAO $DEP_BIBLIOTECAS $DEP_FERRAMENTAS $DEP_REDE $DEP_OPCIONAIS $DEP_TERMUX"
    
    local total_pacotes=$(echo "$TODAS_DEP" | wc -w)
    local contador=0
    local sucessos=0
    local falhas=0
    
    print_msg "Total de pacotes a instalar: $total_pacotes"
    echo ""
    
    for pacote in $TODAS_DEP; do
        contador=$((contador + 1))
        echo -ne "${AZUL}[${contador}/${total_pacotes}]${RESET} Instalando ${BOLD}$pacote${RESET}... "
        
        # ESTRATÉGIA 1: Instalação normal
        if pkg install -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓${RESET}"
            sucessos=$((sucessos + 1))
        # ESTRATÉGIA 2: Com allow-unauthenticated
        elif pkg install -y --allow-unauthenticated "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (alt)${RESET}"
            sucessos=$((sucessos + 1))
        # ESTRATÉGIA 3: Reinstalação
        elif pkg reinstall -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (re)${RESET}"
            sucessos=$((sucessos + 1))
        else
            echo -e "${VERMELHO}✗${RESET}"
            falhas=$((falhas + 1))
            log_erro "Falha ao instalar $pacote"
        fi
    done
    
    echo ""
    print_sucesso "Instalação concluída: $sucessos sucessos, $falhas falhas"
    echo ""
}

