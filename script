        fi
    else
        echo -e "${RED}INATIVO${NC}"
        return 1
    fi
}

# ============================================================================
# FUNÇÃO 21: HASHARATE ATUAL
# ============================================================================
current_hashrate() {
    local hashrate="0"
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        hashrate=$(tail -200 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "speed.*[0-9]+\.[0-9]+" | tail -1 | grep -oE "[0-9]+\.[0-9]+" || echo "0")
    fi
    echo "$hashrate"
}

# ============================================================================
# FUNÇÃO 22: HASHARATE MÉDIO
# ============================================================================
average_hashrate() {
    local samples=10
    local total=0
    local count=0
    
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        tail -500 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "speed.*[0-9]+\.[0-9]+" | tail -$samples | grep -oE "[0-9]+\.[0-9]+" | while read rate; do
            total=$(echo "$total + $rate" | bc 2>/dev/null)
            count=$((count + 1))
        done
        
        if [ $count -gt 0 ]; then
            echo "scale=2; $total / $count" | bc 2>/dev/null
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 23: SHARES ACEITOS
# ============================================================================
accepted_shares() {
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        grep -c "accepted" "$MINER_LOGS/xmrig.log" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 24: SHARES REJEITADOS
# ============================================================================
rejected_shares() {
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        grep -c "rejected" "$MINER_LOGS/xmrig.log" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 25: TAXA DE ACEITAÇÃO
# ============================================================================
acceptance_rate() {
    local accepted=$(accepted_shares)
    local rejected=$(rejected_shares)
    local total=$((accepted + rejected))
    
    if [ $total -gt 0 ]; then
        echo "scale=2; $accepted * 100 / $total" | bc 2>/dev/null
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 26: DIFICULDADE ATUAL
# ============================================================================
current_diff() {
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        local diff=$(tail -100 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "diff [0-9]+" | tail -1 | grep -oE "[0-9]+" || echo "0")
        echo "$diff"
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 27: UPTIME DA MINERAÇÃO
# ============================================================================
mining_uptime() {
    if [ -f "$MINER_CONFIG/mining.pid" ]; then
        local pid=$(cat "$MINER_CONFIG/mining.pid")
        if kill -0 $pid 2>/dev/null 2>&1; then
            local uptime=$(ps -o etimes= -p $pid 2>/dev/null | tr -d ' ')
            echo "$uptime"
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 28: COLETAR ESTATÍSTICAS
# ============================================================================
collect_stats() {
    mkdir -p "$MINER_STATS"
    
    local timestamp=$(timestamp_sec)
    local hashrate=$(current_hashrate)
    local accepted=$(accepted_shares)
    local rejected=$(rejected_shares)
    local diff=$(current_diff)
    local uptime=$(mining_uptime)
    
    # Salvar estatísticas atuais
    echo "$hashrate" > "$MINER_STATS/hashrate"
    echo "$accepted" > "$MINER_STATS/accepted"
    echo "$rejected" > "$MINER_STATS/rejected"
    echo "$diff" > "$MINER_STATS/difficulty"
    echo "$uptime" > "$MINER_STATS/uptime"
    
    # Histórico
    echo "$timestamp,$hashrate,$accepted,$rejected,$diff" >> "$MINER_STATS/history.csv"
    
    # Manter apenas últimas 1000 linhas do histórico
    if [ -f "$MINER_STATS/history.csv" ]; then
        tail -1000 "$MINER_STATS/history.csv" > "$MINER_STATS/history.csv.tmp"
        mv "$MINER_STATS/history.csv.tmp" "$MINER_STATS/history.csv"
    fi
}

# ============================================================================
# FUNÇÃO 29: MONITOR EM TEMPO REAL
# ============================================================================
live_monitor() {
    clear
    echo -e "${PURPLE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════╗"
    echo "║               RANDOMX LIVE MONITOR - TEMPO REAL                  ║"
    echo "╚══════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    
    local refresh=2
    local count=0
    
    while true; do
        # Atualizar estatísticas a cada 30 segundos
        if [ $((count % 15)) -eq 0 ]; then
            collect_stats
        fi
        
        # Limpar tela e posicionar cursor no topo
        echo -ne "\033[2J\033[H"
        
        # Cabeçalho
        echo -e "${PURPLE}══════════════════════════════════════════════════════════════════${NC}"
        echo -e "${WHITE}  RANDOMX LIVE MONITOR - $(date '+%Y-%m-%d %H:%M:%S')${NC}"
        echo -e "${PURPLE}══════════════════════════════════════════════════════════════════${NC}\n"
        
        # Status
        echo -ne "${WHITE}Status:${NC} "
        if [ -f "$MINER_CONFIG/mining.pid" ]; then
            local pid=$(cat "$MINER_CONFIG/mining.pid")
            if kill -0 $pid 2>/dev/null 2>&1; then
                echo -e "${GREEN}ATIVO${NC} (PID: $pid)"
            else
                echo -e "${RED}INATIVO${NC}"
                rm -f "$MINER_CONFIG/mining.pid"
            fi
        else
            echo -e "${RED}INATIVO${NC}"
        fi
        
        # Estatísticas
        local hashrate=$(current_hashrate)
        local accepted=$(accepted_shares)
        local rejected=$(rejected_shares)
        local rate=$(acceptance_rate)
        local diff=$(current_diff)
        local uptime=$(mining_uptime)
        
        echo -e "${WHITE}Hashrate:${NC} $(format_hash $hashrate)"
        echo -e "${WHITE}Hashrate Médio:${NC} $(format_hash $(average_hashrate))"
        echo -e "${WHITE}Shares:${NC} ${GREEN}✓ $accepted${NC} | ${RED}✗ $rejected${NC} | Taxa: ${rate}%"
        echo -e "${WHITE}Dificuldade:${NC} $diff"
        echo -e "${WHITE}Tempo de Execução:${NC} $(format_time $uptime)"
        
        # Temperatura
        if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
            local temp=$(cat /sys/class/thermal/thermal_zone0/temp | awk '{print $1/1000}')
            if (( $(echo "$temp > 70" | bc -l 2>/dev/null) )); then
                echo -e "${WHITE}Temperatura:${NC} ${RED}${temp}°C (ALTA)${NC}"
            else
                echo -e "${WHITE}Temperatura:${NC} ${temp}°C"
            fi
        fi
        
        # Memória
        if [ -f /proc/meminfo ]; then
            local mem_free=$(grep MemFree /proc/meminfo | awk '{print $2}')
            local mem_total=$(grep MemTotal /proc/meminfo | awk '{print $2}')
            local mem_used=$(( (mem_total - mem_free) * 100 / mem_total ))
            echo -e "${WHITE}Memória:${NC} ${mem_used}% usado"
        fi
        
        # Pool atual
        if [ -f "$MINER_CONFIG/current_pool" ]; then
            local pool=$(cat "$MINER_CONFIG/current_pool")
            echo -e "${WHITE}Pool:${NC} $pool"
        fi
        
        # Últimos logs
        echo -e "\n${WHITE}Últimas atividades:${NC}"
        tail -5 "$MINER_LOGS/xmrig.log" 2>/dev/null | while read line; do
            if echo "$line" | grep -q "accepted"; then
                echo -e "  ${GREEN}✓${NC} ${line:0:70}..."
            elif echo "$line" | grep -q "rejected"; then
                echo -e "  ${RED}✗${NC} ${line:0:70}..."
            elif echo "$line" | grep -q "speed"; then
                echo -e "  ${CYAN}⚡${NC} ${line:0:70}..."
            else
                echo -e "  ${DIM}${line:0:70}...${NC}"
            fi
        done
        
        echo -e "\n${DIM}Pressione Ctrl+C para sair do monitor${NC}"
        echo -e "${DIM}Atualizando a cada ${refresh} segundos...${NC}"
        
        sleep $refresh
        count=$((count + 1))
    done
}

# ============================================================================
# FUNÇÃO 30: BENCHMARK RANDOMX
# ============================================================================
run_benchmark() {
    log "BENCH" "Iniciando benchmark RandomX..."
    
    if ! check_xmrig; then
        install_xmrig || return 1
    fi
    
    local bench_time=60
    local bench_file="$MINER_TEMP/benchmark_$(date +%s).log"
    
    echo -e "\n${CYAN}Executando benchmark RandomX por ${bench_time} segundos...${NC}\n"
    
    # Executar benchmark
    "$MINER_BIN/xmrig" --bench=1M --randomx-mode=$RANDOMX_MODE --print-time=10 > "$bench_file" 2>&1 &
    local bench_pid=$!
    
    # Barra de progresso
    for i in $(seq 1 $((bench_time / 10))); do
        echo -ne "Progresso: $((i*10))% ["
        for j in $(seq 1 $i); do echo -n "#"; done
        for j in $(seq $i 6); do echo -n " "; done
        echo -ne "]\r"
        sleep 10
    done
    echo ""
    
    # Finalizar benchmark
    kill $bench_pid 2>/dev/null
    sleep 2
    
    # Analisar resultados
    local hashrate=$(grep -o "totals.*" "$bench_file" | grep -oE "[0-9]+\.[0-9]+" | head -1)
    local min_hash=$(grep -o "min [0-9]+\.[0-9]+" "$bench_file" | grep -oE "[0-9]+\.[0-9]+" | head -1)
    local max_hash=$(grep -o "max [0-9]+\.[0-9]+" "$bench_file" | grep -oE "[0-9]+\.[0-9]+" | head -1)
    
    if [ -n "$hashrate" ]; then
        echo -e "\n${GREEN}═══════════════════════════════════════════${NC}"
        echo -e "${WHITE}RESULTADOS DO BENCHMARK RANDOMX:${NC}"
        echo -e "${GREEN}═══════════════════════════════════════════${NC}"
        echo -e "Hashrate Médio: ${BOLD}$(format_hash $hashrate)${NC}"
        echo -e "Hashrate Mínimo: $(format_hash $min_hash)"
        echo -e "Hashrate Máximo: $(format_hash $max_hash)"
        echo ""
        
        # Recomendações baseadas no resultado
        if (( $(echo "$hashrate > 2000" | bc -l 2>/dev/null) )); then
            echo -e "${GREEN}⚡ Excelente performance! Use modo 'fast'${NC}"
            echo "Recomendação: RANDOMX_MODE=fast, 1GB Pages ativado"
        elif (( $(echo "$hashrate > 1000" | bc -l 2>/dev/null) )); then
            echo -e "${YELLOW}⚡ Boa performance! Use modo 'auto'${NC}"
            echo "Recomendação: RANDOMX_MODE=auto, 1GB Pages opcional"
        else
            echo -e "${BLUE}⚡ Performance moderada. Use modo 'light'${NC}"
            echo "Recomendação: RANDOMX_MODE=light, 1GB Pages desativado"
        fi
        
        # Salvar resultado
        echo "$hashrate" > "$MINER_STATS/benchmark"
        echo "$(date +%s),$hashrate,$min_hash,$max_hash" >> "$MINER_STATS/benchmarks.csv"
        
        log "BENCH" "Benchmark concluído: $(format_hash $hashrate)"
    else
        log "ERROR" "Falha ao executar benchmark"
        tail -20 "$bench_file"
    fi
}

# ============================================================================
# FUNÇÃO 31: TESTAR LATÊNCIA DAS POOLS
# ============================================================================
test_pools() {
    echo -e "\n${CYAN}Testando latência das pools RandomX...${NC}"
    echo "══════════════════════════════════════════════════════════════════"
    
    local results=()
    local i=1
    
    for pool in "${POOLS[@]}"; do
        local host=$(echo "$pool" | cut -d: -f1)
        local port=$(echo "$pool" | cut -d: -f2)
        
        echo -ne "Pool $i: $pool ... "
        
        # Teste de ping
        local ping_time=$(ping -c 1 -W 2 "$host" 2>/dev/null | grep 'time=' | cut -d= -f4 | cut -d' ' -f1)
        
        if [ -n "$ping_time" ]; then
            echo -e "${GREEN}${ping_time}ms${NC}"
            results+=("$ping_time:$pool")
        else
            # Teste de conexão TCP
            if command -v nc > /dev/null && nc -z -w 2 "$host" "$port" 2>/dev/null; then
                echo -e "${YELLOW}conecta (ping falhou)${NC}"
                results+=("999:$pool")
            else
                echo -e "${RED}falhou${NC}"
            fi
        fi
        
        i=$((i + 1))
    done
    
    echo "══════════════════════════════════════════════════════════════════"
    echo -e "\n${GREEN}Top 5 pools mais rápidas:${NC}"
    
    # Ordenar e mostrar top 5
    printf '%s\n' "${results[@]}" | sort -n | head -5 | while IFS=: read lat pool; do
        echo "  $pool - ${lat}ms"
    done
}

# ============================================================================
# FUNÇÃO 32: TROCAR MODO RANDOMX
# ============================================================================
change_randomx_mode() {
    echo -e "\n${CYAN}Configuração do Modo RandomX${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Modos disponíveis:"
    echo "  1) fast  - Máximo desempenho (recomendado para 4+GB RAM)"
    echo "             • Usa mais memória"
    echo "             • Melhor hashrate"
    echo "             • Consumo maior de bateria"
    echo ""
    echo "  2) light - Economia de memória (recomendado para <3GB RAM)"
    echo "             • Usa menos memória"
    echo "             • Hashrate reduzido"
    echo "             • Consumo moderado"
    echo ""
    echo "  3) auto  - Automático (deixa o XMRig decidir)"
    echo "             • Alterna entre modos conforme necessidade"
    echo "             • Balanceado"
    echo ""
    read -p "Escolha (1-3): " mode_choice
    
    case $mode_choice in
        1) 
            RANDOMX_MODE="fast"
            log "RANDOMX" "Modo alterado para: fast (máximo desempenho)"
            ;;
        2) 
            RANDOMX_MODE="light"
            log "RANDOMX" "Modo alterado para: light (economia)"
            ;;
