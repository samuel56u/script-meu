# ============================================================================
# FUNÇÃO 77: INICIALIZAÇÃO DO SISTEMA
# ============================================================================
init_system() {
    clear
    echo -e "${PURPLE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════╗"
    echo "║           RANDOMX MONERO MINER - TERMUX ANDROID                  ║"
    echo "║                    INICIALIZANDO SISTEMA...                      ║"
    echo "╚══════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    
    create_directories
    detect_hardware
    check_termux_permissions
    check_dependencies
    detect_architecture
    
    echo ""
    if ! check_xmrig; then
        echo -e "${YELLOW}XMRig não encontrado. Deseja instalar agora? (s/n)${NC}"
        read -p "> " install_choice
        if [ "$install_choice" = "s" ] || [ "$install_choice" = "S" ]; then
            install_xmrig_all_methods
        fi
    else
        local version=$("$MINER_BIN/xmrig" --version 2>/dev/null | head -1)
        log "SUCCESS" "XMRig já está instalado: ${version:-versão desconhecida}"
    fi
    
    if [ ! -f "$MINER_CONFIG/current_pool" ]; then
        POOL="${POOLS[0]}"
        echo "$POOL" > "$MINER_CONFIG/current_pool" 2>/dev/null
        log "INFO" "Pool padrão configurada: $POOL"
    fi
    
    if [ ! -f "$MINER_CONFIG/current_wallet" ]; then
        WALLET="${WALLETS[0]}"
        echo "$WALLET" > "$MINER_CONFIG/current_wallet" 2>/dev/null
        log "INFO" "Carteira de exemplo configurada"
    fi
    
    if [ ! -f "$MINER_CONFIG/worker.id" ]; then
        WORKER="android-$(date +%s | tail -c 5)"
        echo "$WORKER" > "$MINER_CONFIG/worker.id" 2>/dev/null
    fi
    
    if [ ! -f "$MINER_CONFIG/config.json" ] && [ -f "$MINER_CONFIG/current_pool" ] && [ -f "$MINER_CONFIG/current_wallet" ]; then
        POOL=$(cat "$MINER_CONFIG/current_pool" 2>/dev/null)
        WALLET=$(cat "$MINER_CONFIG/current_wallet" 2>/dev/null)
        WORKER=$(cat "$MINER_CONFIG/worker.id" 2>/dev/null)
        generate_config "$WALLET" "$POOL"
    fi
    
    # Iniciar processos em background
    (
        while true; do
            sleep 300
            auto_recovery
        done
    ) &
    
    (
        while true; do
            sleep 30
            collect_stats
        done
    ) &
    
    send_notification "RandomX Miner" "Sistema inicializado"
    
    show_main_menu
}

# ============================================================================
# FUNÇÃO 78: OBTER IP LOCAL (CORRIGIDO)
# ============================================================================
get_local_ip() {
    local ip="127.0.0.1"
    
    if command -v ip >/dev/null 2>&1; then
        ip=$(ip addr show 2>/dev/null | grep -o 'inet [0-9.]\+' | grep -v '127.0.0.1' | head -1 | cut -d' ' -f2)
    elif command -v ifconfig >/dev/null 2>&1; then
        ip=$(ifconfig 2>/dev/null | grep -o 'inet addr:[0-9.]\+' | head -1 | cut -d: -f2)
    fi
    
    echo "${ip:-127.0.0.1}"
}

# ============================================================================
# TRAP PARA LIMPEZA
# ============================================================================
cleanup() {
    echo -e "\n${YELLOW}Finalizando RandomX Miner...${NC}"
    stop_mining
    if command -v termux-wake-unlock >/dev/null 2>&1; then
        termux-wake-unlock 2>/dev/null
    fi
    send_notification "RandomX Miner" "Sistema encerrado"
    exit 0
}

trap cleanup SIGINT SIGTERM EXIT

# ============================================================================
# INÍCIO
# ============================================================================
init_system

