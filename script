        hashrate=$(tail -200 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "speed.*[0-9]+\.[0-9]+" | tail -1 | grep -oE "[0-9]+\.[0-9]+" || echo "0")
    fi
    echo "$hashrate"
}

# ============================================================================
# FUNÇÃO 52: HASHARATE MÉDIO (CORRIGIDO)
# ============================================================================
average_hashrate() {
    local samples=10
    local total=0
    local count=0
    
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        while read -r rate; do
            if [ -n "$rate" ]; then
                # Extrair parte inteira
                local int_part=$(echo "$rate" | cut -d. -f1)
                if [ -n "$int_part" ]; then
                    total=$((total + int_part))
                    count=$((count + 1))
                fi
            fi
        done <<< "$(tail -500 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "speed.*[0-9]+\.[0-9]+" | tail -$samples | grep -oE "[0-9]+\.[0-9]+")"
        
        if [ $count -gt 0 ]; then
            echo $((total / count))
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 53: SHARES ACEITOS
# ============================================================================
accepted_shares() {
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        grep -c "accepted" "$MINER_LOGS/xmrig.log" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 54: SHARES REJEITADOS
# ============================================================================
rejected_shares() {
    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        grep -c "rejected" "$MINER_LOGS/xmrig.log" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 55: TAXA DE ACEITAÇÃO
# ============================================================================
acceptance_rate() {
    local accepted=$(accepted_shares)
    local rejected=$(rejected_shares)
    local total=$((accepted + rejected))
    
    if [ $total -gt 0 ]; then
        echo $((accepted * 100 / total))
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 56: DIFICULDADE ATUAL
