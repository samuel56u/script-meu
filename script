# Função para testar minerador de forma precisa
testar_minerador_preciso() {
    local miner="$1"
    log_teste "Testando minerador: $miner"
    if [ ! -f "$miner" ]; then
        log_teste "ERRO: Arquivo não existe"
        return 1
    fi
    if [ ! -x "$miner" ]; then
        log_teste "Arquivo sem permissão de execução. Corrigindo..."
        chmod +x "$miner"
    fi
    if "$miner" --version > /dev/null 2>&1; then
        local versao=$("$miner" --version 2>&1 | head -n1)
        log_teste "Minerador responde ao --version: $versao"
    elif "$miner" -h > /dev/null 2>&1; then
        log_teste "Minerador responde ao -h"
    elif "$miner" --help > /dev/null 2>&1; then
        log_teste "Minerador responde ao --help"
    else
        log_teste "Minerador não responde a comandos básicos"
    fi
    log_teste "Teste básico concluído"
    return 0
}

