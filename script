# Verifica se um comando existe e é executável
verificar_comando() {
    local cmd="$1"
    local nome="$2"
    log_verificacao "Verificando comando: $cmd ($nome)"
    if command -v "$cmd" &> /dev/null; then
        local path=$(which "$cmd")
        local versao=$("$cmd" --version 2>/dev/null | head -n1 || echo "versão desconhecida")
        log_verificacao "OK: $nome encontrado em $path ($versao)"
        return 0
    else
        log_verificacao "FALTA: $nome ($cmd) não encontrado"
        return 1
    fi
}

# Verifica se um arquivo existe, é legível e tem tamanho mínimo
verificar_arquivo() {
    local arquivo="$1"
    local descricao="$2"
    local tamanho_minimo="${3:-0}"
    log_verificacao "Verificando arquivo: $arquivo ($descricao)"
    if [ ! -e "$arquivo" ]; then
        log_verificacao "ERRO: Arquivo não existe"
        return 1
    fi
    if [ ! -r "$arquivo" ]; then
        log_verificacao "ERRO: Arquivo sem permissão de leitura"
        return 1
    fi
    if [ -f "$arquivo" ] && [ "$tamanho_minimo" -gt 0 ]; then
        local tamanho=$(stat -c%s "$arquivo" 2>/dev/null || echo "0")
        if [ "$tamanho" -lt "$tamanho_minimo" ]; then
            log_verificacao "ERRO: Arquivo muito pequeno ($tamanho bytes < $tamanho_minimo)"
            return 1
        fi
    fi
    log_verificacao "OK: Arquivo válido"
    return 0
}

# Verifica conectividade de rede de forma robusta
verificar_conexao_rede() {
    log_verificacao "Verificando conexão de rede..."
    local servidores=("8.8.8.8" "1.1.1.1" "9.9.9.9" "208.67.222.222")
    local sucesso=0
    for servidor in "${servidores[@]}"; do
        if ping -c 2 -W 5 "$servidor" > /dev/null 2>&1; then
            local latencia=$(ping -c 1 "$servidor" 2>/dev/null | grep 'time=' | awk -F'time=' '{print $2}' | cut -d' ' -f1)
            log_verificacao "Conexão com $servidor OK (latência: ${latencia:-N/A}ms)"
            sucesso=1
            break
        else
            log_verificacao "Falha ao conectar com $servidor"
        fi
    done
    if [ $sucesso -eq 1 ]; then
        if nslookup google.com > /dev/null 2>&1; then
            log_verificacao "Resolução DNS OK"
        else
            log_aviso "Resolução DNS com problemas"
        fi
        return 0
    fi
    log_verificacao "FALHA: Sem conectividade com a internet"
    return 1
}

# Verifica espaço em disco com precisão
verificar_espaco_disco() {
    local minimo_mb="$1"
    local path="${2:-$BASE_DIR}"
    log_verificacao "Verificando espaço em disco em $path (mínimo: ${minimo_mb}MB)"
    local espaco_livre=$(df -m "$path" 2>/dev/null | tail -n1 | awk '{print $4}')
    if [ -z "$espaco_livre" ] || [ "$espaco_livre" -le 0 ] 2>/dev/null; then
        log_verificacao "ERRO: Não foi possível determinar espaço em disco"
        return 1
    fi
    log_verificacao "Espaço livre: ${espaco_livre}MB"
    if [ "$espaco_livre" -lt "$minimo_mb" ]; then
        log_verificacao "INSUFICIENTE: ${espaco_livre}MB < ${minimo_mb}MB"
        return 1
    fi
    log_verificacao "SUFICIENTE: ${espaco_livre}MB >= ${minimo_mb}MB"
    return 0
}

# █████████████████████████████████████████████████████████████████████████████
# DIAGNÓSTICO PRECISO DO SISTEMA (ADAPTADO DA VERSÃO 5.2)
# █████████████████████████████████████████████████████████████████████████████

diagnostico_sistema() {
    print_destaque "\n>>> DIAGNÓSTICO PRECISO DO SISTEMA <<<\n"
    
    local manufacturer=$(getprop ro.product.manufacturer 2>/dev/null || echo "Desconhecido")
    local model=$(getprop ro.product.model 2>/dev/null || echo "Desconhecido")
    local android=$(getprop ro.build.version.release 2>/dev/null || echo "Desconhecido")
    local api=$(getprop ro.build.version.sdk 2>/dev/null || echo "?")
    local kernel=$(uname -r)
    local arch=$(uname -m)
    local cores=$(nproc)
    local platform=$(getprop ro.board.platform 2>/dev/null || echo "Desconhecido")

    echo -e "${BOLD}DISPOSITIVO:${RESET} $manufacturer $model"
    echo -e "${BOLD}ANDROID:${RESET} $android (API $api)"
    echo -e "${BOLD}KERNEL:${RESET} $kernel"
    echo -e "${BOLD}ARQUITETURA:${RESET} $arch"
    echo -e "\n${BOLD}CPU:${RESET}"
    echo -e "  Núcleos totais: $cores"
    echo -e "  Processador: $platform"

    # Memória RAM (com tratamento)
    if command -v free &> /dev/null; then
        local mem_info=$(free -b 2>/dev/null | grep Mem)
        if [ -n "$mem_info" ]; then
            local mem_total=$(echo "$mem_info" | awk '{print $2}')
            local mem_livre=$(echo "$mem_info" | awk '{print $4}')
            if [ -n "$mem_total" ] && [ -n "$mem_livre" ] && [ "$mem_total" -gt 0 ] 2>/dev/null; then
                local mem_uso=$((mem_total - mem_livre))
                local mem_percent=$((mem_uso * 100 / mem_total))
                echo -e "\n${BOLD}MEMÓRIA RAM:${RESET}"
                echo -e "  Total: $(numfmt --to=iec $mem_total 2>/dev/null || echo "${mem_total} bytes")"
                echo -e "  Em uso: $(numfmt --to=iec $mem_uso 2>/dev/null || echo "${mem_uso} bytes") ($mem_percent%)"
                echo -e "  Livre: $(numfmt --to=iec $mem_livre 2>/dev/null || echo "${mem_livre} bytes")"
            fi
        fi
    fi

    # Armazenamento (com tratamento)
    local storage_info=$(df -B1 ~ 2>/dev/null | tail -n1)
    if [ -n "$storage_info" ]; then
        local storage_total=$(echo "$storage_info" | awk '{print $2}')
        local storage_usado=$(echo "$storage_info" | awk '{print $3}')
        local storage_livre=$(echo "$storage_info" | awk '{print $4}')
        if [ -n "$storage_total" ] && [ -n "$storage_usado" ] && [ -n "$storage_livre" ] && [ "$storage_total" -gt 0 ] 2>/dev/null; then
            local storage_percent=$((storage_usado * 100 / storage_total))
            echo -e "\n${BOLD}ARMAZENAMENTO:${RESET}"
            echo -e "  Total: $(numfmt --to=iec $storage_total 2>/dev/null || echo "${storage_total} bytes")"
            echo -e "  Usado: $(numfmt --to=iec $storage_usado 2>/dev/null || echo "${storage_usado} bytes") ($storage_percent%)"
            echo -e "  Livre: $(numfmt --to=iec $storage_livre 2>/dev/null || echo "${storage_livre} bytes")"
        fi
    fi

    # Rede
    echo -e "\n${BOLD}REDE:${RESET}"
    if verificar_conexao_rede; then
        echo -e "  Conectividade: ${VERDE}OK${RESET}"
        local ip=$(curl -s --connect-timeout 5 ifconfig.me 2>/dev/null || echo "N/A")
        echo -e "  IP público: $ip"
    else
        echo -e "  Conectividade: ${VERMELHO}FALHA${RESET}"
    fi

    # Temperatura
    for temp_path in /sys/class/thermal/thermal_zone*/temp; do
        if [ -f "$temp_path" ]; then
            local temp=$(cat "$temp_path" 2>/dev/null | awk '{print $1/1000}')
            echo -e "  Temperatura: ${temp}°C"
            break
        fi
    done

    # Bateria
    if command -v termux-battery-status &> /dev/null; then
        local battery_info=$(termux-battery-status 2>/dev/null)
        if [ -n "$battery_info" ]; then
            local bateria=$(echo "$battery_info" | grep -o '"percentage":[0-9]*' | cut -d: -f2)
            local status=$(echo "$battery_info" | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
            echo -e "\n${BOLD}BATERIA:${RESET} $bateria% ($status)"
        fi
    fi
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# VERIFICAÇÃO PRECISA DO AMBIENTE
# █████████████████████████████████████████████████████████████████████████████

verificar_ambiente_preciso() {
    print_titulo "VERIFICAÇÃO PRECISA DO AMBIENTE TERMUX"
    local erros=0
    local avisos=0

    # 1. Ambiente Termux
    print_msg "Verificando ambiente Termux..."
    if [ ! -d /data/data/com.termux ]; then
        print_critico "Este script só pode ser executado no Termux!"
    else
        print_sucesso "Ambiente Termux confirmado"
    fi

    # 2. Permissões de armazenamento
    print_msg "Verificando permissões de armazenamento..."
    if [ ! -d ~/storage ]; then
        print_msg "Solicitando permissões..."
        yes | termux-setup-storage > /dev/null 2>&1
        sleep 3
    fi
    if [ -d ~/storage ]; then
        print_sucesso "Permissões de armazenamento OK"
    else
        print_aviso "Permissões de armazenamento não concedidas"
        avisos=$((avisos + 1))
    fi

    # 3. Espaço em disco (precisamos de pelo menos 2GB para compilações)
    print_msg "Verificando espaço em disco (mínimo 2GB)..."
    if verificar_espaco_disco 2048; then
        print_sucesso "Espaço em disco suficiente"
    else
        local espaco=$(df -h ~ | tail -n1 | awk '{print $4}')
        print_aviso "Espaço em disco limitado: $espaco (recomendado >2GB)"
        avisos=$((avisos + 1))
    fi

    # 4. Conexão com internet
    print_msg "Verificando conexão com internet..."
    if verificar_conexao_rede; then
        print_sucesso "Conexão com internet OK"
    else
        print_erro "Sem conexão com internet. Tentando novamente em 10s..."
        sleep 10
        if verificar_conexao_rede; then
            print_sucesso "Conexão estabelecida na segunda tentativa"
        else
            print_critico "Sem conexão com internet. Abortando."
        fi
    fi

    # 5. Comandos essenciais
    print_msg "Verificando comandos essenciais..."
    local comandos_essenciais=("pkg" "curl" "wget" "git" "tar" "gzip" "make" "gcc")
    local faltando=()
    for cmd in "${comandos_essenciais[@]}"; do
        if ! verificar_comando "$cmd" "$cmd"; then
            faltando+=("$cmd")
        fi
    done
    if [ ${#faltando[@]} -eq 0 ]; then
        print_sucesso "Todos os comandos essenciais disponíveis"
    else
        print_aviso "Comandos faltando: ${faltando[*]}. Tentando instalar..."
        pkg update -y >> "$LOG_SISTEMA" 2>&1
        pkg install -y "${faltando[@]}" >> "$LOG_SISTEMA" 2>&1
        for cmd in "${faltando[@]}"; do
            if verificar_comando "$cmd" "$cmd"; then
                print_sucesso "$cmd instalado"
            else
                print_erro "Não foi possível instalar $cmd"
                erros=$((erros + 1))
            fi
        done
    fi

    # 6. termux-api
    print_msg "Verificando termux-api..."
    if verificar_comando "termux-wake-lock" "termux-api"; then
        print_sucesso "termux-api disponível"
    else
        print_msg "Instalando termux-api..."
        pkg install -y termux-api >> "$LOG_SISTEMA" 2>&1
        if verificar_comando "termux-wake-lock" "termux-api"; then
            print_sucesso "termux-api instalado"
        else
            print_aviso "termux-api não disponível (funcionalidade limitada)"
            avisos=$((avisos + 1))
        fi
    fi

    # 7. Ativar wake lock
    if command -v termux-wake-lock &> /dev/null; then
        termux-wake-lock
        print_sucesso "Wake lock ativado (dispositivo não dormirá)"
    fi

    echo ""
    print_destaque "RESUMO DA VERIFICAÇÃO:"
    echo -e "  ${BOLD}Erros:${RESET} $erros"
    echo -e "  ${BOLD}Avisos:${RESET} $avisos"
    echo ""
    if [ $erros -gt 0 ]; then
        print_critico "Erros críticos encontrados. Corrija-os antes de continuar."
    fi
    if [ $avisos -gt 0 ]; then
        print_aviso "Existem avisos, mas é possível continuar."
    fi
}

# █████████████████████████████████████████████████████████████████████████████
# ATUALIZAÇÃO PRECISA DO SISTEMA (ADAPTADA)
# █████████████████████████████████████████████████████████████████████████████

atualizar_sistema_preciso() {
    print_titulo "ATUALIZAÇÃO PRECISA DO SISTEMA"
    local tentativa=1
    while [ $tentativa -le $MAX_TENTATIVAS ]; do
        print_msg "Tentativa $tentativa de $MAX_TENTATIVAS: Atualizando repositórios..."
        if pkg update -y >> "$LOG_SISTEMA" 2>&1; then
            print_sucesso "Repositórios atualizados na tentativa $tentativa"
            break
        else
            print_aviso "Falha na atualização (tentativa $tentativa)"
            if [ $tentativa -lt $MAX_TENTATIVAS ]; then
                sleep 10
            fi
        fi
        tentativa=$((tentativa + 1))
    done

    tentativa=1
    while [ $tentativa -le $MAX_TENTATIVAS ]; do
        print_msg "Tentativa $tentativa de $MAX_TENTATIVAS: Atualizando pacotes..."
        if pkg upgrade -y >> "$LOG_SISTEMA" 2>&1; then
            print_sucesso "Pacotes atualizados na tentativa $tentativa"
            break
        else
            print_aviso "Falha na atualização de pacotes (tentativa $tentativa)"
            if [ $tentativa -lt $MAX_TENTATIVAS ]; then
                sleep 10
            fi
        fi
        tentativa=$((tentativa + 1))
    done
    echo ""
}

