# ============================================================================
# FUNÇÃO 47: INICIAR MINERAÇÃO (CORRIGIDO PARA ANDROID)
# ============================================================================
start_mining() {
    log "MINER" "Iniciando processo de mineração RandomX..."
    
    # Verificar bateria
    if command -v termux-battery-status > /dev/null 2>&1; then
        local battery=$(termux-battery-status 2>/dev/null)
        if [ -n "$battery" ] && [ "$battery" != "{}" ]; then
            local percent=$(echo "$battery" | grep -o '"percentage":[0-9]*' | cut -d: -f2)
            local status=$(echo "$battery" | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
            
            if [ -n "$percent" ] && [ "$percent" -lt 15 ] && [ "$status" != "CHARGING" ]; then
                log "WARNING" "Bateria baixa (${percent}%) e não carregando. Mineração não iniciada."
                send_notification "Bateria Baixa" "Conecte o carregador para minerar" "high"
                return 1
            fi
        fi
    fi
    
    # Wake lock
    if command -v termux-wake-lock > /dev/null 2>&1; then
        termux-wake-lock 2>/dev/null
        log "TERMUX" "Wake lock ativado"
    fi
    
    if [ -f "$MINER_CONFIG/miner.pid" ]; then
        local pid=$(cat "$MINER_CONFIG/miner.pid" 2>/dev/null)
        if kill -0 "$pid" 2>/dev/null; then
            log "WARNING" "Mineração já está ativa (PID: $pid)"
            return 0
        else
            rm -f "$MINER_CONFIG/miner.pid" 2>/dev/null
        fi
    fi
    
    if ! check_xmrig; then
        log "INFO" "Instalando XMRig..."
        install_xmrig_all_methods || return 1
    fi
    
    if [ ! -f "$MINER_CONFIG/config.json" ]; then
        if [ ! -f "$MINER_CONFIG/current_wallet" ] || [ ! -f "$MINER_CONFIG/current_pool" ]; then
            log "ERROR" "Configure primeiro a carteira e pool"
            return 1
        fi
        WALLET=$(cat "$MINER_CONFIG/current_wallet" 2>/dev/null)
        POOL=$(cat "$MINER_CONFIG/current_pool" 2>/dev/null)
        generate_config "$WALLET" "$POOL"
    fi
    
    cd "$MINER_ROOT" 2>/dev/null || return 1
    
    # Limpar logs antigos
    > "$MINER_LOGS/xmrig.log" 2>/dev/null
    
    log "MINER" "Executando: $MINER_BIN/xmrig -c $MINER_CONFIG/config.json"
    nohup "$MINER_BIN/xmrig" -c "$MINER_CONFIG/config.json" >> "$MINER_LOGS/xmrig.log" 2>&1 &
    local pid=$!
    
    sleep 5
    
    if kill -0 "$pid" 2>/dev/null; then
        echo "$pid" > "$MINER_CONFIG/miner.pid" 2>/dev/null
        log "SUCCESS" "Mineração RandomX iniciada (PID: $pid)"
        
        send_notification "RandomX Miner" "Mineração iniciada - PID: $pid"
        vibrate_device 200
        
        collect_stats
    else
        log "ERROR" "Falha ao iniciar mineração"
        tail -20 "$MINER_LOGS/xmrig.log" 2>/dev/null
        return 1
    fi
}

# ============================================================================
# FUNÇÃO 48: PARAR MINERAÇÃO
# ============================================================================
stop_mining() {
    log "MINER" "Parando mineração..."
    
    if command -v termux-wake-unlock > /dev/null 2>&1; then
        termux-wake-unlock 2>/dev/null
        log "TERMUX" "Wake lock desativado"
    fi
    
    if [ ! -f "$MINER_CONFIG/miner.pid" ]; then
        log "WARNING" "Mineração não está ativa"
        return 0
    fi
    
    local pid=$(cat "$MINER_CONFIG/miner.pid" 2>/dev/null)
    
    if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        sleep 3
        
        if kill -0 "$pid" 2>/dev/null; then
            log "WARNING" "Processo não respondeu, forçando parada..."
            kill -9 "$pid" 2>/dev/null
            sleep 1
        fi
    fi
    
    rm -f "$MINER_CONFIG/miner.pid" 2>/dev/null
    log "SUCCESS" "Mineração parada"
    send_notification "RandomX Miner" "Mineração parada"
    collect_stats
}

