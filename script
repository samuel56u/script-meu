# MÉTODO 10: Minerador C simples (fallback extremo)
metodo10_minerador_simples() {
    log_metodo "MÉTODO 10: Criando minerador C simples"
    print_msg "M10: Criando minerador C mínimo"
    
    cd ~
    cat > minero_simples.c << 'CEOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <time.h>

typedef struct {
    int thread_id;
    unsigned long hashes;
} thread_data_t;

void* mine_thread(void* arg) {
    thread_data_t* data = (thread_data_t*)arg;
    unsigned long count = 0;
    time_t last_report = time(NULL);
    
    while(1) {
        count++;
        data->hashes = count;
        
        time_t now = time(NULL);
        if(now - last_report >= 5) {
            printf("[Thread %d] Hashrate: %lu H/s\n", 
                   data->thread_id, count / 5);
            count = 0;
            last_report = now;
        }
    }
    return NULL;
}

int main(int argc, char* argv[]) {
    int threads = sysconf(_SC_NPROCESSORS_ONLN);
    printf("╔════════════════════════════════════════════════════════╗\n");
    printf("║     MINERADOR C SIMPLES - VERSÃO DIDÁTICA             ║\n");
    printf("╚════════════════════════════════════════════════════════╝\n");
    printf("Threads: %d\n", threads);
    printf("AVISO: Este minerador não se conecta a pools!\n");
    printf("Use apenas para testes de performance da CPU.\n\n");
    
    pthread_t* thread_array = malloc(threads * sizeof(pthread_t));
    thread_data_t* thread_data = malloc(threads * sizeof(thread_data_t));
    
    for(int i = 0; i < threads; i++) {
        thread_data[i].thread_id = i;
        thread_data[i].hashes = 0;
        pthread_create(&thread_array[i], NULL, mine_thread, &thread_data[i]);
        printf("Thread %d iniciada\n", i);
    }
    
    printf("\nMinerando... Pressione Ctrl+C para parar\n");
    
    for(int i = 0; i < threads; i++) {
        pthread_join(thread_array[i], NULL);
    }
    
    free(thread_array);
    free(thread_data);
    return 0;
}
CEOF

    # Compila o minerador simples
    if gcc -o $PREFIX/bin/minero-simples minero_simples.c -lpthread >> "$LOG_METODOS" 2>&1; then
        chmod +x $PREFIX/bin/minero-simples
        log_metodo "M10: Minerador C simples compilado"
        # Não define MINER_PATH porque não é funcional para NiceHash
    fi
    
    return 1
}

