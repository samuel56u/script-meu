# █████████████████████████████████████████████████████████████████████████████

# Variável global para armazenar o caminho do minerador
MINER_PATH=""
declare -a METODOS_SUCESSO=()

# MÉTODO 1: Pacote oficial cpuminer
metodo1_pacote_oficial() {
    log_metodo "MÉTODO 1: Tentando pacote oficial cpuminer"
    print_msg "M1: Pacote oficial cpuminer"
    
    if pkg install -y cpuminer >> "$LOG_METODOS" 2>&1; then
        if command -v cpuminer &> /dev/null; then
            MINER_PATH=$(which cpuminer)
            log_metodo "M1: SUCESSO - $MINER_PATH"
            METODOS_SUCESSO+=("M1: Pacote oficial")
            return 0
        fi
    fi
    return 1
}

# MÉTODO 2: Pacote minerd (nome alternativo)
metodo2_pacote_minerd() {
    log_metodo "MÉTODO 2: Tentando pacote minerd"
    print_msg "M2: Pacote minerd"
    
    if pkg install -y minerd >> "$LOG_METODOS" 2>&1; then
        if command -v minerd &> /dev/null; then
            MINER_PATH=$(which minerd)
            log_metodo "M2: SUCESSO - $MINER_PATH"
            METODOS_SUCESSO+=("M2: Pacote minerd")
            return 0
        fi
    fi
    return 1
}

# MÉTODO 3: Compilar cpuminer (pooler) com otimizações
metodo3_compilar_pooler() {
    log_metodo "MÉTODO 3: Compilando pooler/cpuminer"
    print_msg "M3: Compilando pooler/cpuminer (otimizado)"
    
    cd ~
    rm -rf cpuminer_pooler
    git clone https://github.com/pooler/cpuminer.git cpuminer_pooler >> "$LOG_METODOS" 2>&1
    cd cpuminer_pooler
    
    # Tenta diferentes flags de otimização
    local flags=(
        "-O3 -march=native -mtune=native -funroll-loops"
        "-O3 -march=armv8-a -mtune=cortex-a53 -funroll-loops"
        "-O3 -mcpu=native -mtune=native -funroll-loops"
    )
    
    for flag in "${flags[@]}"; do
        ./autogen.sh >> "$LOG_METODOS" 2>&1
        ./configure --prefix=$PREFIX CFLAGS="$flag" >> "$LOG_METODOS" 2>&1
        make clean >> "$LOG_METODOS" 2>&1
        make -j$(nproc) >> "$LOG_METODOS" 2>&1
        
        if [ -f minerd ]; then
            cp minerd $PREFIX/bin/cpuminer-pooler
            chmod +x $PREFIX/bin/cpuminer-pooler
            MINER_PATH="$PREFIX/bin/cpuminer-pooler"
            log_metodo "M3: SUCESSO com flags $flag"
            METODOS_SUCESSO+=("M3: Pooler otimizado")
            return 0
        fi
    done
    
    return 1
}

# MÉTODO 4: Compilar cpuminer-multi (tpruvot)
metodo4_compilar_multi() {
    log_metodo "MÉTODO 4: Compilando cpuminer-multi"
    print_msg "M4: Compilando cpuminer-multi (tpruvot)"
    
