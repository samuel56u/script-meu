# ============================================================================
# FUNÇÃO 73: VERIFICAR ATUALIZAÇÕES
# ============================================================================
check_for_updates() {
    log "UPDATE" "Verificando atualizações..."
    
    if ! command -v curl >/dev/null 2>&1; then
        pkg install -y curl > /dev/null 2>&1
    fi
    
    local current_version=$("$MINER_BIN/xmrig" --version 2>/dev/null | head -1 | grep -oE "[0-9]+\.[0-9]+\.[0-9]+" || echo "0.0.0")
    local latest_version=$(curl -s https://api.github.com/repos/xmrig/xmrig/releases/latest 2>/dev/null | grep "tag_name" | cut -d'"' -f4 | sed 's/v//')
    
    echo -e "\n${CYAN}Verificação de Atualizações${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Versão atual: $current_version"
    echo "Última versão: ${latest_version:-não disponível}"
    
    if [ -n "$latest_version" ] && [ "$current_version" != "$latest_version" ] && [ "$current_version" != "0.0.0" ]; then
        echo -e "${YELLOW}Nova versão disponível: $latest_version${NC}"
        echo ""
        read -p "Deseja atualizar? (s/n): " update_choice
        
        if [ "$update_choice" = "s" ] || [ "$update_choice" = "S" ]; then
            log "UPDATE" "Iniciando atualização..."
            stop_mining
            rm -f "$MINER_BIN/xmrig" 2>/dev/null
            rm -rf "$MINER_CACHE/xmrig" 2>/dev/null
            
            if install_xmrig_all_methods; then
                log "SUCCESS" "XMRig atualizado com sucesso para versão $latest_version"
                send_notification "Atualização Concluída" "XMRig atualizado para v$latest_version"
            else
                log "ERROR" "Falha ao atualizar XMRig"
            fi
        fi
    elif [ "$current_version" = "0.0.0" ]; then
        echo -e "${YELLOW}Não foi possível determinar a versão atual${NC}"
    else
        echo -e "${GREEN}Você está usando a versão mais recente${NC}"
    fi
}

# ============================================================================
# FUNÇÃO 74: AUTO-RECUPERAÇÃO (CORRIGIDO)
# ============================================================================
auto_recovery() {
    if [ -f "$MINER_CONFIG/miner.pid" ]; then
        local pid=$(cat "$MINER_CONFIG/miner.pid" 2>/dev/null)
        if ! kill -0 "$pid" 2>/dev/null; then
            log "WARNING" "Mineração parou inesperadamente. Reiniciando..."
            rm -f "$MINER_CONFIG/miner.pid" 2>/dev/null
            start_mining
            send_notification "Auto-Recuperação" "Mineração reiniciada automaticamente"
            vibrate_device 200
        fi
    fi
}

# ============================================================================
# FUNÇÃO 75: EDITAR CONFIGURAÇÃO MANUAL
# ============================================================================
edit_config_manual() {
    if [ ! -f "$MINER_CONFIG/config.json" ]; then
        log "WARNING" "Arquivo de configuração não encontrado"
        return
    fi
    
    echo -e "\n${YELLOW}Editando configuração manualmente...${NC}"
    echo "Use Ctrl+O para salvar e Ctrl+X para sair"
    sleep 2
    
    if command -v nano >/dev/null 2>&1; then
        nano "$MINER_CONFIG/config.json"
    elif command -v vi >/dev/null 2>&1; then
        vi "$MINER_CONFIG/config.json"
    else
        log "ERROR" "Nenhum editor encontrado (nano/vi)"
        return
    fi
    
    log "CONFIG" "Configuração editada manualmente"
    
    # Validar JSON se python estiver disponível
    if command -v python3 >/dev/null 2>&1; then
        if python3 -c "import json; f=open('$MINER_CONFIG/config.json'); json.load(f)" 2>/dev/null; then
            log "SUCCESS" "Configuração válida"
        else
            log "ERROR" "Configuração inválida! Restaure o backup se necessário"
        fi
    fi
    
    if [ -f "$MINER_CONFIG/miner.pid" ]; then
        log "INFO" "Reinicie a mineração para aplicar as alterações"
    fi
}

