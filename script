# MÉTODO 3: Compilar cpuminer (pooler) com otimizações
metodo3_compilar_pooler() {
    log_metodo "MÉTODO 3: Compilando pooler/cpuminer"
    print_msg "M3: Compilando pooler/cpuminer"
    
    cd ~
    rm -rf cpuminer_pooler
    git clone https://github.com/pooler/cpuminer.git cpuminer_pooler >> "$LOG_METODOS" 2>&1
    if [ $? -ne 0 ]; then
        log_erro "Falha ao clonar repositório pooler"
        return 1
    fi
    
    cd cpuminer_pooler
    
    ./autogen.sh >> "$LOG_METODOS" 2>&1
    ./configure --prefix=$PREFIX CFLAGS="-O3 -march=native" >> "$LOG_METODOS" 2>&1
    
    if make -j$(nproc) >> "$LOG_METODOS" 2>&1; then
        if [ -f minerd ]; then
            cp minerd $PREFIX/bin/cpuminer-pooler
            chmod +x $PREFIX/bin/cpuminer-pooler
            MINER_PATH="$PREFIX/bin/cpuminer-pooler"
            log_metodo "M3: SUCESSO"
            METODOS_SUCESSO+=("M3: Pooler")
            return 0
        elif [ -f cpuminer ]; then
            cp cpuminer $PREFIX/bin/cpuminer-pooler
            chmod +x $PREFIX/bin/cpuminer-pooler
            MINER_PATH="$PREFIX/bin/cpuminer-pooler"
            log_metodo "M3: SUCESSO"
            METODOS_SUCESSO+=("M3: Pooler")
            return 0
        fi
    fi
    
    cd ~
    return 1
}

