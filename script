    if [ -f "$MINER_LOGS/xmrig.log" ]; then
        local diff=$(tail -100 "$MINER_LOGS/xmrig.log" 2>/dev/null | grep -oE "diff [0-9]+" | tail -1 | grep -oE "[0-9]+" || echo "0")
