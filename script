# ============================================================================
# FUNÇÃO 39: BACKUP CONFIGURAÇÕES
# ============================================================================
backup_config() {
    mkdir -p "$MINER_BACKUP"
    local backup_file="$MINER_BACKUP/config_$(date +%Y%m%d_%H%M%S).tar.gz"
    
    log "BACKUP" "Criando backup das configurações..."
    
    tar -czf "$backup_file" \
        -C "$MINER_CONFIG" . \
        -C "$MINER_ROOT" "profiles" 2>/dev/null
    
    if [ $? -eq 0 ] && [ -f "$backup_file" ]; then
        local size=$(du -h "$backup_file" | cut -f1)
        log "SUCCESS" "Backup criado: $(basename "$backup_file") (${size})"
        
        # Manter apenas últimos 10 backups
        ls -t "$MINER_BACKUP"/config_*.tar.gz 2>/dev/null | tail -n +11 | xargs rm -f
    else
        log "ERROR" "Falha ao criar backup"
    fi
}

# ============================================================================
# FUNÇÃO 40: RESTAURAR BACKUP
# ============================================================================
restore_backup() {
    echo -e "\n${CYAN}Backups disponíveis:${NC}"
    echo "═══════════════════════════════════════════════════"
    
    local backups=($(ls -t "$MINER_BACKUP"/config_*.tar.gz 2>/dev/null))
    
    if [ ${#backups[@]} -eq 0 ]; then
        log "WARNING" "Nenhum backup encontrado"
        return
    fi
    
    local i=1
    for backup in "${backups[@]}"; do
        local size=$(du -h "$backup" | cut -f1)
        local date=$(basename "$backup" | sed 's/config_\(.*\).tar.gz/\1/')
        echo "  $i) $date - ${size}"
        i=$((i + 1))
    done
    
    echo ""
    read -p "Escolha o backup (1-${#backups[@]}): " choice
    
    if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#backups[@]}" ]; then
        local selected="${backups[$((choice-1))]}"
        
        echo -e "${YELLOW}Isso irá sobrescrever as configurações atuais. Continuar? (s/n)${NC}"
        read -p "> " confirm
        
        if [ "$confirm" = "s" ] || [ "$confirm" = "S" ]; then
            stop_mining
            tar -xzf "$selected" -C "$MINER_CONFIG" 2>/dev/null
            log "SUCCESS" "Backup restaurado: $(basename "$selected")"
            
            # Recarregar configurações
            if [ -f "$MINER_CONFIG/current_wallet" ] && [ -f "$MINER_CONFIG/current_pool" ]; then
                WALLET=$(cat "$MINER_CONFIG/current_wallet")
                POOL=$(cat "$MINER_CONFIG/current_pool")
                generate_config "$WALLET" "$POOL"
            fi
        else
            log "INFO" "Restauração cancelada"
        fi
    else
        log "ERROR" "Opção inválida"
    fi
}

