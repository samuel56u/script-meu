# ============================================================================
# FUNÇÃO 36: VER LOGS
# ============================================================================
view_logs() {
    local lines="${1:-50}"
    
    if [ ! -f "$MINER_LOGS/xmrig.log" ]; then
        log "WARNING" "Nenhum log encontrado"
        return
    fi
    
    echo -e "\n${CYAN}Últimas $lines linhas do log:${NC}"
    echo "═══════════════════════════════════════════════════"
    
    tail -n "$lines" "$MINER_LOGS/xmrig.log" | while read line; do
        if echo "$line" | grep -q "accepted"; then
            echo -e "${GREEN}✓${NC} $line"
        elif echo "$line" | grep -q "rejected"; then
            echo -e "${RED}✗${NC} $line"
        elif echo "$line" | grep -q "speed"; then
            echo -e "${CYAN}⚡${NC} $line"
        elif echo "$line" | grep -q "error"; then
            echo -e "${RED}⚠${NC} $line"
        elif echo "$line" | grep -q "warning"; then
            echo -e "${YELLOW}⚠${NC} $line"
        else
            echo "  $line"
        fi
    done
}

