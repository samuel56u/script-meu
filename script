# ============================================================================
# FUNÇÃO 01: LOG AVANÇADO
# ============================================================================
log() {
    local level="$1"
    local message="$2"
    local timestamp="[$(date '+%Y-%m-%d %H:%M:%S.%3N')]"
    local log_file="$MINER_LOGS/system.log"
    
    mkdir -p "$MINER_LOGS"
    
    # Log em arquivo
    echo "${timestamp} [${level}] ${message}" >> "$log_file"
    
    # Logs específicos por nível
    case "$level" in
        "ERROR")   echo "$timestamp [ERROR] $message" >> "$MINER_LOGS/error.log" ;;
        "WARNING") echo "$timestamp [WARNING] $message" >> "$MINER_LOGS/warning.log" ;;
        "SUCCESS") echo "$timestamp [SUCCESS] $message" >> "$MINER_LOGS/success.log" ;;
        "DEBUG")   echo "$timestamp [DEBUG] $message" >> "$MINER_LOGS/debug.log" ;;
    esac
    
    # Rotação automática
    if [ -f "$log_file" ] && [ $(stat -c%s "$log_file" 2>/dev/null || echo "0") -gt 10485760 ]; then
        mv "$log_file" "${log_file}.$(date '+%Y%m%d%H%M%S')"
        gzip "${log_file}.$(date '+%Y%m%d%H%M%S')" 2>/dev/null &
    fi
    
    # Output colorido
    case "$level" in
        "ERROR")   echo -e "${RED}[ERROR]${NC} ${message}" ;;
        "WARNING") echo -e "${YELLOW}[WARNING]${NC} ${message}" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} ${message}" ;;
        "INFO")    echo -e "${CYAN}[INFO]${NC} ${message}" ;;
        "DEBUG")   echo -e "${DIM}[DEBUG]${NC} ${message}" ;;
        "MINER")   echo -e "${LIME}[MINER]${NC} ${message}" ;;
        "POOL")    echo -e "${BLUE}[POOL]${NC} ${message}" ;;
        "WALLET")  echo -e "${GOLD}[WALLET]${NC} ${message}" ;;
        "RANDOMX") echo -e "${PURPLE}[RANDOMX]${NC} ${message}" ;;
        "BENCH")   echo -e "${MAGENTA}[BENCH]${NC} ${message}" ;;
        "SYSTEM")  echo -e "${WHITE}[SYSTEM]${NC} ${message}" ;;
        *)         echo -e "${WHITE}[${level}]${NC} ${message}" ;;
    esac
}

# ============================================================================
# FUNÇÃO 02: GERAR UUID
# ============================================================================
generate_uuid() {
    local uuid=""
    if [ -f /proc/sys/kernel/random/uuid ]; then
        uuid=$(cat /proc/sys/kernel/random/uuid)
    else
        uuid=$(date +%s%N)-$RANDOM-$RANDOM-$RANDOM
    fi
    echo "$uuid"
}

# ============================================================================
# FUNÇÃO 03: TIMESTAMP
# ============================================================================
timestamp() {
    date +%s%3N
}

# ============================================================================
# FUNÇÃO 04: TIMESTAMP SEGUNDOS
# ============================================================================
timestamp_sec() {
    date +%s
}

# ============================================================================
# FUNÇÃO 05: FORMATAR TEMPO
# ============================================================================
format_time() {
    local seconds=$1
    local hours=$((seconds / 3600))
    local minutes=$(((seconds % 3600) / 60))
    local secs=$((seconds % 60))
    printf "%02d:%02d:%02d" $hours $minutes $secs
}

# ============================================================================
# FUNÇÃO 06: FORMATAR HASH
# ============================================================================
format_hash() {
    local hash=$1
    if (( $(echo "$hash > 1000000" | bc -l 2>/dev/null) )); then
        echo "$(echo "scale=2; $hash/1000000" | bc) MH/s"
    elif (( $(echo "$hash > 1000" | bc -l 2>/dev/null) )); then
        echo "$(echo "scale=2; $hash/1000" | bc) KH/s"
    else
        echo "$(echo "scale=2; $hash" | bc) H/s"
    fi
}

# ============================================================================
# FUNÇÃO 07: DETECTAR HARDWARE COMPLETO
# ============================================================================
detect_hardware() {
    log "SYSTEM" "Iniciando detecção detalhada de hardware..."
    
    # CPU Info
    export CPU_MODEL=$(cat /proc/cpuinfo 2>/dev/null | grep "model name" | head -1 | cut -d: -f2 | sed 's/^ //' || echo "Unknown")
    export CPU_VENDOR=$(cat /proc/cpuinfo 2>/dev/null | grep "vendor_id" | head -1 | cut -d: -f2 | sed 's/^ //' || echo "Unknown")
    export CPU_CORES_PHYSICAL=$(cat /proc/cpuinfo 2>/dev/null | grep "cpu cores" | head -1 | cut -d: -f2 | sed 's/^ //' || echo "$CPU_CORES")
    export CPU_CORES_LOGICAL=$(nproc 2>/dev/null || echo "4")
    export CPU_FREQ_MIN=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq 2>/dev/null | awk '{print $1/1000}' || echo "0")
    export CPU_FREQ_MAX=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq 2>/dev/null | awk '{print $1/1000}' || echo "0")
    export CPU_FREQ_CUR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null | awk '{print $1/1000}' || echo "0")
    export CPU_GOVERNOR=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "unknown")
    
    # Memória
    export MEM_TOTAL=$(($(cat /proc/meminfo 2>/dev/null | grep MemTotal | awk '{print $2}') / 1024 2>/dev/null || echo "0"))
    export MEM_FREE=$(($(cat /proc/meminfo 2>/dev/null | grep MemFree | awk '{print $2}') / 1024 2>/dev/null || echo "0"))
    export MEM_AVAILABLE=$(($(cat /proc/meminfo 2>/dev/null | grep MemAvailable | awk '{print $2}') / 1024 2>/dev/null || echo "0"))
    export MEM_SWAP_TOTAL=$(($(cat /proc/meminfo 2>/dev/null | grep SwapTotal | awk '{print $2}') / 1024 2>/dev/null || echo "0"))
    export MEM_SWAP_FREE=$(($(cat /proc/meminfo 2>/dev/null | grep SwapFree | awk '{print $2}') / 1024 2>/dev/null || echo "0"))
    
    # HugePages
    export HUGEPAGES_TOTAL=$(cat /proc/sys/vm/nr_hugepages 2>/dev/null || echo "0")
    export HUGEPAGES_SIZE=$(cat /proc/meminfo 2>/dev/null | grep Hugepagesize | awk '{print $2}' || echo "0")
    
    # AES-NI
    if grep -q aes /proc/cpuinfo 2>/dev/null; then
        export AES_NI_SUPPORTED=true
    else
        export AES_NI_SUPPORTED=false
    fi
    
    # ARM Cryptography
    if grep -q "crc32" /proc/cpuinfo 2>/dev/null; then
        export ARM_CRC=true
    else
        export ARM_CRC=false
    fi
    
    # Temperatura
    export THERMAL_ZONES=$(ls -d /sys/class/thermal/thermal_zone* 2>/dev/null | wc -l)
    export CPU_TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{print $1/1000}' || echo "35")
    
    # Armazenamento
    export STORAGE_TOTAL=$(df -P /data 2>/dev/null | tail -1 | awk '{print $2}' || echo "0")
    export STORAGE_USED=$(df -P /data 2>/dev/null | tail -1 | awk '{print $3}' || echo "0")
    export STORAGE_FREE=$(df -P /data 2>/dev/null | tail -1 | awk '{print $4}' || echo "0")
    export STORAGE_PERCENT=$(df -P /data 2>/dev/null | tail -1 | awk '{print $5}' | sed 's/%//' || echo "0")
    
    log "HARDWARE" "CPU: $CPU_MODEL ($CPU_CORES_LOGICAL cores)"
    log "HARDWARE" "Frequência: ${CPU_FREQ_MIN}MHz - ${CPU_FREQ_MAX}MHz (atual: ${CPU_FREQ_CUR}MHz)"
    log "HARDWARE" "Memória: ${MEM_TOTAL}MB total, ${MEM_AVAILABLE}MB disponível"
    log "HARDWARE" "AES-NI: $AES_NI_SUPPORTED | HugePages: ${HUGEPAGES_TOTAL}x${HUGEPAGES_SIZE}KB"
}

# ============================================================================
# FUNÇÃO 08: VERIFICAR PERMISSÕES TERMUX
# ============================================================================
check_permissions() {
    log "TERMUX" "Verificando permissões do Termux..."
    
    # Storage
    if [ ! -d ~/storage ]; then
        log "WARNING" "Storage não configurado. Executando termux-setup-storage..."
        termux-setup-storage 2>/dev/null
        sleep 3
    fi
    
    # Termux:API
    if ! command -v termux-api > /dev/null; then
        log "WARNING" "Termux:API não instalado. Funcionalidades limitadas."
        log "INFO" "Instale com: pkg install termux-api"
    else
        log "SUCCESS" "Termux:API instalado"
    fi
    
    # Wake lock
    if command -v termux-wake-lock > /dev/null; then
        termux-wake-lock 2>/dev/null
        log "SUCCESS" "Wake lock ativado"
    fi
    
    # Bateria
    if command -v termux-battery-status > /dev/null; then
        local battery=$(termux-battery-status 2>/dev/null)
        local percent=$(echo "$battery" | grep -o '"percentage":[0-9]*' | cut -d: -f2)
        local status=$(echo "$battery" | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
        log "BATTERY" "Nível: ${percent}% | Status: ${status}"
    fi
}

# ============================================================================
# FUNÇÃO 09: NOTIFICAÇÃO
# ============================================================================
send_notification() {
    local title="$1"
    local content="$2"
    local priority="${3:-normal}"
    
    if command -v termux-notification > /dev/null; then
        termux-notification \
            --title "$title" \
            --content "$content" \
            --priority "$priority" \
            --id "randomx_miner" \
            --vibrate 500 \
            --sound 2>/dev/null
        log "NOTIFICATION" "$title: $content"
    fi
}

# ============================================================================
# FUNÇÃO 10: VIBRAR
# ============================================================================
vibrate() {
    local duration="${1:-500}"
    if command -v termux-vibrate > /dev/null; then
        termux-vibrate -d "$duration" 2>/dev/null
        log "HARDWARE" "Vibração ativada por ${duration}ms"
    fi
}

# ============================================================================
# FUNÇÃO 11: TEXTO PARA FALA
# ============================================================================
speak() {
    local text="$1"
    if command -v termux-tts-speak > /dev/null; then
        termux-tts-speak "$text" 2>/dev/null
        log "TERMUX" "Texto falado: $text"
    fi
}

