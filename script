configurar_autostart_preciso() {
    print_titulo "CONFIGURANDO INICIALIZAÇÃO AUTOMÁTICA"
    print_msg "Configurando .bashrc..."
    if ! grep -q "mineracao_precisa" ~/.bashrc; then
        cat >> ~/.bashrc << 'BASHRCEOF'
if [ -f ~/mineracao_precisa/scripts/minerar_preciso.sh ]; then
    echo "Para iniciar mineração precisa: screen -dmS mineracao_precisa ~/mineracao_precisa/scripts/minerar_preciso.sh"
fi
BASHRCEOF
        print_sucesso ".bashrc configurado"
    fi
    print_msg "Configurando termux-boot..."
    mkdir -p ~/.termux/boot
    cat > ~/.termux/boot/start_miner_preciso << 'BOOTEOF'
#!/data/data/com.termux/files/usr/bin/sh
termux-wake-lock
sleep 30
cd /data/data/com.termux/files/home/mineracao_precisa
nohup ./scripts/minerar_preciso.sh >> logs/boot.log 2>&1 &
BOOTEOF
    chmod +x ~/.termux/boot/start_miner_preciso
    print_sucesso "termux-boot configurado"
    echo ""
}

