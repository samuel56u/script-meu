# Cores para output (24 bits true color)
VERDE='\033[0;32m'
VERMELHO='\033[0;31m'
AMARELO='\033[1;33m'
AZUL='\033[0;34m'
MAGENTA='\033[0;35m'
CIANO='\033[0;36m'
BRANCO='\033[1;37m'
PRETO='\033[0;30m'
VERDE_CLARO='\033[1;32m'
VERMELHO_CLARO='\033[1;31m'
AMARELO_CLARO='\033[1;33m'
AZUL_CLARO='\033[1;34m'
MAGENTA_CLARO='\033[1;35m'
CIANO_CLARO='\033[1;36m'
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
ITALICO='\033[3m'
SUBLINHADO='\033[4m'
PISCANDO='\033[5m'
INVERSO='\033[7m'

# █████████████████████████████████████████████████████████████████████████████
# FUNÇÕES DE LOG AVANÇADAS
# █████████████████████████████████████████████████████████████████████████████

# Configuração de logs
LOG_DIR=~/mineracao/logs
LOG_PRINCIPAL="$LOG_DIR/principal.log"
LOG_ERROS="$LOG_DIR/erros.log"
LOG_DEBUG="$LOG_DIR/debug.log"
LOG_INSTALACAO="$LOG_DIR/instalacao.log"
LOG_MINERACAO="$LOG_DIR/mineracao.log"
LOG_SISTEMA="$LOG_DIR/sistema.log"
LOG_MONITOR="$LOG_DIR/monitor.log"
LOG_PERFORMANCE="$LOG_DIR/performance.log"
LOG_REDE="$LOG_DIR/rede.log"
LOG_COMPILACAO="$LOG_DIR/compilacao.log"
LOG_FALLBACK="$LOG_DIR/fallback.log"
LOG_METODOS="$LOG_DIR/metodos.log"
LOG_WALLET="$LOG_DIR/wallet.log"
LOG_POOL="$LOG_DIR/pool.log"
LOG_THREADS="$LOG_DIR/threads.log"

# Cria diretório de logs com permissões adequadas
mkdir -p "$LOG_DIR"
chmod 755 "$LOG_DIR"

# Inicializa todos os logs com cabeçalho
inicializar_logs() {
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    local cabecalho="═════════════════════════════════════════════════════════════════════════════════\n"
    cabecalho+="LOG INICIADO EM: $timestamp\n"
    cabecalho+="TERMUX VERSÃO: $(termux-info 2>/dev/null | head -n1)\n"
    cabecalho+="DISPOSITIVO: $(getprop ro.product.model 2>/dev/null || echo "Desconhecido")\n"
    cabecalho+="ANDROID: $(getprop ro.build.version.release 2>/dev/null || echo "Desconhecido")\n"
    cabecalho+="ARQUITETURA: $(uname -m)\n"
    cabecalho+="NÚCLEOS CPU: $(nproc)\n"
    cabecalho+="MEMÓRIA RAM: $(free -h 2>/dev/null | grep Mem | awk '{print $2}' || echo "N/A")\n"
    cabecalho+="ARMAZENAMENTO: $(df -h ~ 2>/dev/null | tail -n1 | awk '{print $2}' || echo "N/A")\n"
    cabecalho+="═════════════════════════════════════════════════════════════════════════════════\n\n"
    
    for log in "$LOG_PRINCIPAL" "$LOG_ERROS" "$LOG_DEBUG" "$LOG_INSTALACAO" "$LOG_MINERACAO" \
                "$LOG_SISTEMA" "$LOG_MONITOR" "$LOG_PERFORMANCE" "$LOG_REDE" "$LOG_COMPILACAO" \
                "$LOG_FALLBACK" "$LOG_METODOS" "$LOG_WALLET" "$LOG_POOL" "$LOG_THREADS"; do
        echo -e "$cabecalho" > "$log"
    done
}

# Função de log universal
log() {
    local nivel="$1"
    local mensagem="$2"
    local arquivo="$3"
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S.%3N")
    local pid=$$
    local funcao="${FUNCNAME[2]:-main}"
    local linha="${BASH_LINENO[1]:-0}"
    
    # Formata a mensagem de log
    local log_entry="[$timestamp] [$nivel] [PID:$pid] [${funcao}:${linha}] $mensagem"
    
    # Salva no arquivo específico
    echo "$log_entry" >> "$arquivo"
    
    # Também salva no log principal
    echo "$log_entry" >> "$LOG_PRINCIPAL"
    
    # Se for erro, salva no log de erros
    if [[ "$nivel" == "ERRO" || "$nivel" == "CRITICO" ]]; then
        echo "$log_entry" >> "$LOG_ERROS"
    fi
    
    # Se for debug, mostra na tela (opcional)
    if [[ "$nivel" == "DEBUG" && "$DEBUG_MODE" == "1" ]]; then
        echo -e "${DIM}[DEBUG]${RESET} $mensagem"
    fi
}

# Funções de logging específicas
log_info() { log "INFO" "$1" "$LOG_INSTALACAO"; }
log_sucesso() { log "SUCESSO" "$1" "$LOG_INSTALACAO"; }
log_aviso() { log "AVISO" "$1" "$LOG_INSTALACAO"; }
log_erro() { log "ERRO" "$1" "$LOG_ERROS"; }
log_critico() { log "CRITICO" "$1" "$LOG_ERROS"; exit 1; }
log_debug() { [[ "$DEBUG_MODE" == "1" ]] && log "DEBUG" "$1" "$LOG_DEBUG"; }
log_metodo() { log "METODO" "$1" "$LOG_METODOS"; }
log_compilacao() { log "COMPILACAO" "$1" "$LOG_COMPILACAO"; }
log_fallback() { log "FALLBACK" "$1" "$LOG_FALLBACK"; }
log_performance() { log "PERFORMANCE" "$1" "$LOG_PERFORMANCE"; }
log_rede() { log "REDE" "$1" "$LOG_REDE"; }
log_mineracao() { log "MINERACAO" "$1" "$LOG_MINERACAO"; }

# Função de output visual
print_msg() { echo -e "${AZUL}[INFO]${RESET} $1"; log_info "$1"; }
print_sucesso() { echo -e "${VERDE}[SUCESSO]${RESET} $1"; log_sucesso "$1"; }
print_aviso() { echo -e "${AMARELO}[AVISO]${RESET} $1"; log_aviso "$1"; }
print_erro() { echo -e "${VERMELHO}[ERRO]${RESET} $1"; log_erro "$1"; }
print_critico() { echo -e "${VERMELHO_CLARO}[CRÍTICO]${RESET} $1"; log_critico "$1"; exit 1; }
print_destaque() { echo -e "${MAGENTA}${BOLD}$1${RESET}"; }
print_titulo() { echo -e "${CIANO}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"; echo -e "${CIANO}${BOLD}$1${RESET}"; echo -e "${CIANO}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"; }

# █████████████████████████████████████████████████████████████████████████████
# FUNÇÕES DE DIAGNÓSTICO DO SISTEMA
# █████████████████████████████████████████████████████████████████████████████

diagnostico_sistema() {
    print_destaque "\n>>> DIAGNÓSTICO DO SISTEMA <<<\n"
    
    # Informações do dispositivo
    echo -e "${BOLD}DISPOSITIVO:${RESET} $(getprop ro.product.manufacturer 2>/dev/null) $(getprop ro.product.model 2>/dev/null)"
    echo -e "${BOLD}ANDROID:${RESET} $(getprop ro.build.version.release 2>/dev/null) (API $(getprop ro.build.version.sdk 2>/dev/null))"
    echo -e "${BOLD}KERNEL:${RESET} $(uname -r)"
    echo -e "${BOLD}ARQUITETURA:${RESET} $(uname -m)"
    
    # CPU
    echo -e "\n${BOLD}CPU:${RESET}"
    echo -e "  Núcleos totais: $(nproc)"
    echo -e "  Processador: $(getprop ro.board.platform 2>/dev/null || echo "Desconhecido")"
    
    # Memória
    local mem_total=$(free -b 2>/dev/null | grep Mem | awk '{print $2}')
    local mem_livre=$(free -b 2>/dev/null | grep Mem | awk '{print $4}')
    local mem_uso=$((mem_total - mem_livre))
    local mem_percent=$((mem_uso * 100 / mem_total))
    
    echo -e "\n${BOLD}MEMÓRIA RAM:${RESET}"
    echo -e "  Total: $(numfmt --to=iec $mem_total)"
    echo -e "  Em uso: $(numfmt --to=iec $mem_uso) ($mem_percent%)"
    echo -e "  Livre: $(numfmt --to=iec $mem_livre)"
    
    # Armazenamento
    local storage_total=$(df -B1 ~ 2>/dev/null | tail -n1 | awk '{print $2}')
    local storage_usado=$(df -B1 ~ 2>/dev/null | tail -n1 | awk '{print $3}')
    local storage_livre=$(df -B1 ~ 2>/dev/null | tail -n1 | awk '{print $4}')
    local storage_percent=$((storage_usado * 100 / storage_total))
    
    echo -e "\n${BOLD}ARMAZENAMENTO:${RESET}"
    echo -e "  Total: $(numfmt --to=iec $storage_total)"
    echo -e "  Usado: $(numfmt --to=iec $storage_usado) ($storage_percent%)"
    echo -e "  Livre: $(numfmt --to=iec $storage_livre)"
    
    # Rede
    echo -e "\n${BOLD}REDE:${RESET}"
    if ping -c 1 8.8.8.8 > /dev/null 2>&1; then
        echo -e "  Conectividade: ${VERDE}OK${RESET}"
        local ip=$(curl -s ifconfig.me 2>/dev/null || echo "N/A")
        echo -e "  IP público: $ip"
    else
        echo -e "  Conectividade: ${VERMELHO}FALHA${RESET}"
    fi
    
    # Temperatura (se disponível)
    for temp_path in /sys/class/thermal/thermal_zone*/temp; do
        if [ -f "$temp_path" ]; then
            local temp=$(cat "$temp_path" 2>/dev/null | awk '{print $1/1000}')
            echo -e "  Temperatura: ${temp}°C"
            break
        fi
    done
    
    # Bateria (se termux-api disponível)
    if command -v termux-battery-status &> /dev/null; then
        local bateria=$(termux-battery-status 2>/dev/null | grep -o '"percentage":[0-9]*' | cut -d: -f2)
        local status=$(termux-battery-status 2>/dev/null | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
        echo -e "\n${BOLD}BATERIA:${RESET}"
        echo -e "  Nível: $bateria%"
        echo -e "  Status: $status"
    fi
    
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# VERIFICAÇÃO DO AMBIENTE
# █████████████████████████████████████████████████████████████████████████████

verificar_ambiente() {
    print_titulo "VERIFICANDO AMBIENTE TERMUX"
    
    # Verifica se está no Termux
    if [ ! -d /data/data/com.termux ]; then
        print_critico "Este script só pode ser executado no Termux!"
    fi
    
    # Verifica permissões de armazenamento
    if [ ! -d ~/storage ]; then
        print_msg "Solicitando permissões de armazenamento..."
        yes | termux-setup-storage > /dev/null 2>&1
        sleep 2
    fi
    
    # Verifica espaço em disco
    local espaco_livre=$(df -m ~ 2>/dev/null | tail -n1 | awk '{print $4}')
    if [ "$espaco_livre" -lt 500 ]; then
        print_aviso "Pouco espaço em disco: ${espaco_livre}MB livres (recomendado >500MB)"
    else
        print_sucesso "Espaço em disco: ${espaco_livre}MB livres"
    fi
    
    # Verifica conexão com internet
    print_msg "Testando conexão com internet..."
    if ping -c 2 8.8.8.8 > /dev/null 2>&1; then
        print_sucesso "Conexão com internet OK"
        
        # Testa latência
        local latencia=$(ping -c 1 8.8.8.8 2>/dev/null | grep 'time=' | awk -F'time=' '{print $2}' | cut -d' ' -f1)
        if [ -n "$latencia" ]; then
            echo -e "  Latência: ${latencia}ms"
        fi
    else
        print_aviso "Sem conexão com internet. Verifique sua rede."
    fi
    
    # Verifica se termux-api está instalado
    if ! command -v termux-wake-lock &> /dev/null; then
        print_msg "Instalando termux-api..."
        pkg install -y termux-api > /dev/null 2>&1
    fi
    
    # Ativa wake lock
    termux-wake-lock
    print_sucesso "Wake lock ativado (dispositivo não dormirá)"
    
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# ATUALIZAÇÃO DO SISTEMA COM MÚLTIPLOS MÉTODOS
# █████████████████████████████████████████████████████████████████████████████

atualizar_sistema() {
    print_titulo "ATUALIZANDO SISTEMA"
    
    # Método 1: Atualização normal
    print_msg "Método 1: Atualizando repositórios..."
    if pkg update -y >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Repositórios atualizados"
    else
        print_aviso "Falha na atualização. Tentando método alternativo..."
        
        # Método 2: Com flags alternativas
        if pkg update -y -o Dpkg::Options::="--force-confnew" >> "$LOG_SISTEMA" 2>&1; then
            print_sucesso "Repositórios atualizados (método 2)"
        else
            # Método 3: Sem verificação de assinatura
            if pkg update -y --allow-unauthenticated >> "$LOG_SISTEMA" 2>&1; then
                print_sucesso "Repositórios atualizados (método 3)"
            else
                print_aviso "Não foi possível atualizar repositórios. Continuando..."
            fi
        fi
    fi
    
    # Upgrade de pacotes com múltiplas tentativas
    print_msg "Atualizando pacotes..."
    
    # Tenta diferentes métodos de upgrade
    if pkg upgrade -y >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Pacotes atualizados"
    elif pkg upgrade -y -o Dpkg::Options::="--force-confnew" >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Pacotes atualizados (método 2)"
    elif pkg upgrade -y --allow-unauthenticated >> "$LOG_SISTEMA" 2>&1; then
        print_sucesso "Pacotes atualizados (método 3)"
    else
        print_aviso "Falha na atualização de pacotes. Continuando..."
    fi
    
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# INSTALAÇÃO DE DEPENDÊNCIAS COM 5 ESTRATÉGIAS DIFERENTES
# █████████████████████████████████████████████████████████████████████████████

instalar_dependencias() {
    print_titulo "INSTALANDO DEPENDÊNCIAS (5 ESTRATÉGIAS)"
    
    # Lista completa de dependências (essenciais + opcionais)
    local DEP_ESSENCIAIS="git wget curl binutils build-essential clang make cmake"
    local DEP_COMPILACAO="autoconf automake libtool pkg-config openssl libcurl jansson"
    local DEP_BIBLIOTECAS="libmicrohttpd libuv hwloc"
    local DEP_FERRAMENTAS="screen tmux nano vim htop bc"
    local DEP_REDE="netcat-openbsd dnsutils traceroute"
    local DEP_OPCIONAIS="neofetch cmatrix figlet toilet cowsay fortune-mod sl hollywood"
    local DEP_TERMUX="termux-api termux-services"
    
    # Combina todas as dependências
    local TODAS_DEP="$DEP_ESSENCIAIS $DEP_COMPILACAO $DEP_BIBLIOTECAS $DEP_FERRAMENTAS $DEP_REDE $DEP_OPCIONAIS $DEP_TERMUX"
    
    # Contador de pacotes
    local total_pacotes=$(echo "$TODAS_DEP" | wc -w)
    local contador=0
    local sucessos=0
    local falhas=0
    
    print_msg "Total de pacotes a instalar: $total_pacotes"
    echo ""
    
    for pacote in $TODAS_DEP; do
        contador=$((contador + 1))
        echo -ne "${AZUL}[${contador}/${total_pacotes}]${RESET} Instalando ${BOLD}$pacote${RESET}... "
        
        # ESTRATÉGIA 1: Instalação normal
        if pkg install -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓${RESET}"
            sucessos=$((sucessos + 1))
            continue
        fi
        
        # ESTRATÉGIA 2: Com allow-unauthenticated
        if pkg install -y --allow-unauthenticated "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (m2)${RESET}"
            sucessos=$((sucessos + 1))
            continue
        fi
        
        # ESTRATÉGIA 3: Forçando reinstalação
        if pkg reinstall -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (m3)${RESET}"
            sucessos=$((sucessos + 1))
            continue
        fi
        
        # ESTRATÉGIA 4: Ignorando dependências
        if pkg install -y --no-deps "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (m4)${RESET}"
            sucessos=$((sucessos + 1))
            continue
        fi
        
        # ESTRATÉGIA 5: Tentando via apt diretamente
        if apt install -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
            echo -e "${VERDE}✓ (m5)${RESET}"
            sucessos=$((sucessos + 1))
            continue
        fi
        
        echo -e "${VERMELHO}✗${RESET}"
        falhas=$((falhas + 1))
        log_erro "Falha ao instalar $pacote após 5 tentativas"
    done
    
    echo ""
    print_sucesso "Instalação concluída: $sucessos sucessos, $falhas falhas"
    
    if [ $falhas -gt 0 ]; then
        print_aviso "$falhas pacotes não puderam ser instalados. Verificando alternativas..."
        
        # Tenta instalar pacotes críticos via compilação
        for pacote_critico in jansson libuv hwloc; do
            if ! pkg list-installed | grep -q "$pacote_critico"; then
                print_msg "Tentando compilar $pacote_critico manualmente..."
                compilar_biblioteca "$pacote_critico"
            fi
        done
    fi
    
    echo ""
}

# █████████████████████████████████████████████████████████████████████████████
# COMPILAÇÃO DE BIBLIOTECAS (FALLBACK)
# █████████████████████████████████████████████████████████████████████████████

compilar_biblioteca() {
    local biblioteca="$1"
    log_compilacao "Iniciando compilação manual de $biblioteca"
    
    case "$biblioteca" in
        jansson)
            cd ~
            rm -rf jansson
            git clone https://github.com/akheron/jansson.git >> "$LOG_COMPILACAO" 2>&1
            cd jansson
            autoreconf -fi >> "$LOG_COMPILACAO" 2>&1
            ./configure --prefix=$PREFIX >> "$LOG_COMPILACAO" 2>&1
            make -j$(nproc) >> "$LOG_COMPILACAO" 2>&1
            make install >> "$LOG_COMPILACAO" 2>&1
            ;;
        libuv)
            cd ~
            rm -rf libuv
            git clone https://github.com/libuv/libuv.git >> "$LOG_COMPILACAO" 2>&1
            cd libuv
            sh autogen.sh >> "$LOG_COMPILACAO" 2>&1
            ./configure --prefix=$PREFIX >> "$LOG_COMPILACAO" 2>&1
            make -j$(nproc) >> "$LOG_COMPILACAO" 2>&1
            make install >> "$LOG_COMPILACAO" 2>&1
            ;;
        hwloc)
            cd ~
            rm -rf hwloc
            git clone https://github.com/open-mpi/hwloc.git >> "$LOG_COMPILACAO" 2>&1
            cd hwloc
            ./autogen.sh >> "$LOG_COMPILACAO" 2>&1
            ./configure --prefix=$PREFIX >> "$LOG_COMPILACAO" 2>&1
            make -j$(nproc) >> "$LOG_COMPILACAO" 2>&1
            make install >> "$LOG_COMPILACAO" 2>&1
            ;;
    esac
    
    cd ~
    print_sucesso "Compilação de $biblioteca concluída"
}

# █████████████████████████████████████████████████████████████████████████████
