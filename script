# █████████████████████████████████████████████████████████████████████████████

instalar_dependencias_preciso() {
    print_titulo "INSTALAÇÃO PRECISA DE DEPENDÊNCIAS"
    
    declare -A DEPENDENCIAS=(
        ["git"]="essencial"
        ["wget"]="essencial"
        ["curl"]="essencial"
        ["binutils"]="essencial"
        ["build-essential"]="compilacao"
        ["clang"]="compilacao"
        ["make"]="compilacao"
        ["cmake"]="compilacao"
        ["autoconf"]="compilacao"
        ["automake"]="compilacao"
        ["libtool"]="compilacao"
        ["pkg-config"]="compilacao"
        ["openssl"]="biblioteca"
        ["libcurl"]="biblioteca"
        ["jansson"]="biblioteca"
        ["libmicrohttpd"]="biblioteca"
        ["libuv"]="biblioteca"
        ["hwloc"]="biblioteca"
        ["screen"]="ferramenta"
        ["tmux"]="ferramenta"
        ["nano"]="ferramenta"
        ["bc"]="ferramenta"
        ["termux-api"]="termux"
        ["termux-services"]="termux"
    )
    
    local total=${#DEPENDENCIAS[@]}
    local contador=0
    local instalados=0
    local falhos=()

    print_msg "Total de dependências a verificar: $total"
    echo ""

    for pacote in "${!DEPENDENCIAS[@]}"; do
        contador=$((contador + 1))
        tipo="${DEPENDENCIAS[$pacote]}"
        echo -ne "${AZUL}[${contador}/${total}]${RESET} Verificando ${BOLD}$pacote${RESET} ($tipo)... "

        if pkg list-installed 2>/dev/null | grep -q "^$pacote$"; then
            echo -e "${VERDE}✓ já instalado${RESET}"
            instalados=$((instalados + 1))
            continue
        fi

        local instalou=0
        local tentativa=1
        while [ $tentativa -le $MAX_TENTATIVAS ] && [ $instalou -eq 0 ]; do
            if pkg install -y "$pacote" >> "$LOG_INSTALACAO" 2>&1; then
                instalou=1
                echo -e "${VERDE}✓ instalado na tentativa $tentativa${RESET}"
                instalados=$((instalados + 1))
            else
                if [ $tentativa -lt $MAX_TENTATIVAS ]; then
                    sleep 5
                fi
            fi
            tentativa=$((tentativa + 1))
        done

        if [ $instalou -eq 0 ]; then
            echo -e "${VERMELHO}✗ falhou após $MAX_TENTATIVAS tentativas${RESET}"
            falhos+=("$pacote")
        fi
    done

    echo ""
    print_sucesso "Instalação concluída: $instalados/$total instalados"
    if [ ${#falhos[@]} -gt 0 ]; then
        print_aviso "Pacotes não instalados: ${falhos[*]}"
        for pacote_critico in git make gcc clang; do
            if [[ " ${falhos[@]} " =~ " ${pacote_critico} " ]]; then
                print_critico "Pacote crítico $pacote_critico não foi instalado. Abortando."
            fi
        done
        print_aviso "Continuando com funcionalidade limitada..."
    fi
    echo ""
}

