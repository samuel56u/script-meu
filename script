# ============================================================================
generate_config() {
    local wallet="$1"
    local pool="$2"
    local worker_id=$(cat "$MINER_CONFIG/worker.id" 2>/dev/null || generate_uuid | cut -c1-8)
    
    mkdir -p "$MINER_CONFIG"
    
    cat > "$MINER_CONFIG/config.json" << EOF
{
    "autosave": true,
    "cpu": {
        "enabled": true,
        "max-threads-hint": $CPU_MAX_USAGE,
        "priority": $CPU_PRIORITY,
        "memory-pool": $CPU_MEMORY_POOL,
        "yield": $CPU_YIELD
    },
    "opencl": false,
    "cuda": false,
    "donate-level": 1,
    "log-file": "$MINER_LOGS/xmrig.log",
    "pools": [
        {
            "url": "$pool",
            "user": "$wallet.$worker_id",
            "pass": "x",
            "rig-id": "$worker_id",
            "nicehash": false,
            "keepalive": $NETWORK_KEEPALIVE,
            "tls": false
        }
    ],
    "randomx": {
        "mode": "$RANDOMX_MODE",
        "1gb-pages": $RANDOMX_1GB_PAGES,
        "rdmsr": true,
        "wrmsr": true,
        "cache_qos": $RANDOMX_CACHE_QOS,
        "numa": $RANDOMX_NUMA,
        "scratchpad_prefetch_mode": $RANDOMX_SCRATCHPAD_PREFETCH
    },
    "api": {
        "enabled": $API_ENABLED,
        "host": "$API_HOST",
        "port": $API_PORT,
        "access-token": "$API_TOKEN"
    }
}
EOF

    echo "$worker_id" > "$MINER_CONFIG/worker.id"
    log "RANDOMX" "Configuração gerada para worker: $worker_id"
}

