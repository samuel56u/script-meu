        echo -e "  23) Editar configuração manual"
        echo ""
        echo -e "  ${WHITE}INFOS RÁPIDAS${NC}"
        echo -e "  24) Mostrar hashrate atual"
        echo -e "  25) Mostrar shares"
        echo -e "  26) Mostrar dificuldade"
        echo -e "  27) Mostrar tempo de execução"
        echo ""
        echo -e "  ${WHITE}SISTEMA${NC}"
        echo -e "   0) Sair"
        echo -e "${PURPLE}══════════════════════════════════════════════════════════════════${NC}"
        echo ""
        read -p "Escolha uma opção (0-27): " choice
        
        case $choice in
            1) start_mining; sleep 2 ;;
            2) stop_mining; sleep 2 ;;
            3) restart_mining; sleep 2 ;;
            4) live_monitor ;;
            5) run_benchmark; read -p "Pressione Enter..." ;;
            6) select_pool; sleep 2 ;;
            7) select_wallet; sleep 2 ;;
            8) change_randomx_mode; sleep 2 ;;
            9) set_threads; sleep 2 ;;
            10) set_priority; sleep 2 ;;
            11) toggle_1gb_pages; sleep 2 ;;
            12) test_pools; read -p "Pressione Enter..." ;;
            13) show_stats; read -p "Pressione Enter..." ;;
            14) view_logs 50; read -p "Pressione Enter..." ;;
            15) view_errors; read -p "Pressione Enter..." ;;
            16) clear_logs; sleep 2 ;;
            17) backup_config; sleep 2 ;;
            18) restore_backup; sleep 2 ;;
            19) export_stats; read -p "Pressione Enter..." ;;
            20) system_info ;;
            21) check_updates; read -p "Pressione Enter..." ;;
            22) auto_recover; sleep 2 ;;
            23) edit_config; sleep 2 ;;
            24) show_hashrate; read -p "Pressione Enter..." ;;
            25) show_shares; read -p "Pressione Enter..." ;;
            26) echo "Dificuldade: $(current_diff)"; read -p "Pressione Enter..." ;;
            27) echo "Tempo: $(format_time $(mining_uptime))"; read -p "Pressione Enter..." ;;
            0) 
                stop_mining
                echo -e "${GREEN}Até mais!${NC}"
                exit 0
                ;;
            *) 
                echo -e "${RED}Opção inválida${NC}"
                sleep 2
                ;;
        esac
        
        # Coletar estatísticas periodicamente
        collect_stats
    done
}

# ============================================================================
# INICIALIZAÇÃO
# ============================================================================
init() {
    # Criar diretórios
    mkdir -p "$MINER_ROOT" "$MINER_BIN" "$MINER_CONFIG" "$MINER_LOGS" \
             "$MINER_STATS" "$MINER_SCRIPTS" "$MINER_BACKUP" "$MINER_TEMP" \
             "$MINER_CACHE" "$MINER_DB" "$MINER_REPORTS"
    
    # Detectar hardware
    detect_hardware
    
    # Verificar permissões
    check_permissions
    
    # Verificar XMRig
    if ! check_xmrig; then
        echo -e "\n${YELLOW}XMRig não encontrado. Deseja instalar? (s/n)${NC}"
        read -p "> " install_choice
        if [ "$install_choice" = "s" ] || [ "$install_choice" = "S" ]; then
            install_xmrig
        fi
    fi
    
    # Verificar configuração básica
    if [ ! -f "$MINER_CONFIG/current_pool" ]; then
        POOL="${POOLS[0]}"
        echo "$POOL" > "$MINER_CONFIG/current_pool"
    fi
    
    if [ ! -f "$MINER_CONFIG/current_wallet" ]; then
        WALLET="${WALLETS[0]}"
        echo "$WALLET" > "$MINER_CONFIG/current_wallet"
    fi
    
    # Gerar configuração se necessário
    if [ ! -f "$MINER_CONFIG/config.json" ]; then
        POOL=$(cat "$MINER_CONFIG/current_pool")
        WALLET=$(cat "$MINER_CONFIG/current_wallet")
        generate_config "$WALLET" "$POOL"
    fi
    
    # Iniciar auto-recuperação em background
    (
        while true; do
            sleep 300
            auto_recover
        done
    ) &
    
    # Iniciar coleta de estatísticas em background
    (
        while true; do
            sleep 30
            collect_stats
        done
    ) &
    
    # Mostrar menu
    show_menu
}

# ============================================================================
# INICIAR
# ============================================================================
init
