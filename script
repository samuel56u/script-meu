    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"mode\": \"[^\"]*\"/\"mode\": \"$RANDOMX_MODE\"/" "$MINER_CONFIG/config.json"
        log "RANDOMX" "Configuração atualizada"
        
        if [ -f "$MINER_CONFIG/mining.pid" ]; then
            log "INFO" "Reinicie a mineração para aplicar as mudanças"
        fi
    fi
}

# ============================================================================
# FUNÇÃO 33: CONFIGURAR THREADS
# ============================================================================
set_threads() {
    echo -e "\n${CYAN}Configuração de Threads CPU${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Núcleos disponíveis: $CPU_CORES"
    echo "Threads atuais: $CPU_THREADS"
    echo ""
    echo "Recomendações:"
    echo "  • Para RandomX, use todos os núcleos disponíveis"
    echo "  • Deixe 1 núcleo livre para o sistema se possível"
    echo ""
    read -p "Quantos threads usar? (1-$CPU_CORES): " threads
    
    if ! [[ "$threads" =~ ^[0-9]+$ ]] || [ "$threads" -lt 1 ] || [ "$threads" -gt "$CPU_CORES" ]; then
        log "ERROR" "Número inválido. Usando $CPU_CORES threads."
        threads=$CPU_CORES
    fi
    
    CPU_THREADS=$threads
    export CPU_THREADS
    
    # Calcular percentual de uso
    local usage=$((threads * 100 / CPU_CORES))
    CPU_MAX_USAGE=$usage
    export CPU_MAX_USAGE
    
    log "CPU" "Threads configurados: $CPU_THREADS/$CPU_CORES (${usage}% de uso)"
    
    # Atualizar configuração
    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"max-threads-hint\": [0-9]*/\"max-threads-hint\": $usage/" "$MINER_CONFIG/config.json"
        log "CPU" "Configuração atualizada"
    fi
}

# ============================================================================
# FUNÇÃO 34: CONFIGURAR PRIORIDADE CPU
# ============================================================================
set_priority() {
    echo -e "\n${CYAN}Configuração de Prioridade CPU${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Níveis de prioridade:"
    echo "   0) idle (mínima) - Só executa quando o sistema está ocioso"
    echo "   5) low (baixa)    - Prioridade baixa"
    echo "  10) normal         - Prioridade normal (padrão)"
    echo "  15) high (alta)    - Prioridade alta"
    echo "  19) realtime       - Máxima prioridade (pode afetar o sistema)"
    echo ""
    echo "Prioridade atual: $CPU_PRIORITY"
    echo ""
    read -p "Escolha a prioridade (0-19): " priority
    
    if ! [[ "$priority" =~ ^[0-9]+$ ]] || [ "$priority" -lt 0 ] || [ "$priority" -gt 19 ]; then
        log "ERROR" "Prioridade inválida. Mantendo $CPU_PRIORITY."
        return
    fi
    
    CPU_PRIORITY=$priority
    export CPU_PRIORITY
    
    # Descrever nível
    case $priority in
        0)  desc="idle (mínima)" ;;
        [1-4]) desc="baixa" ;;
        [5-9]) desc="média-baixa" ;;
        10) desc="normal" ;;
        [11-14]) desc="média-alta" ;;
        [15-18]) desc="alta" ;;
        19) desc="realtime (máxima)" ;;
    esac
    
    log "CPU" "Prioridade alterada para: $priority ($desc)"
    
    # Atualizar configuração
    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"priority\": [0-9]*/\"priority\": $priority/" "$MINER_CONFIG/config.json"
        log "CPU" "Configuração atualizada"
    fi
}

# ============================================================================
# FUNÇÃO 35: CONFIGURAR 1GB PAGES
# ============================================================================
toggle_1gb_pages() {
    echo -e "\n${CYAN}Configuração de 1GB Pages${NC}"
