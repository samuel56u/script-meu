# Inicializa todos os logs com cabeçalho detalhado
inicializar_logs() {
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S.%6N") # Microssegundos para precisão
    local cabecalho="═════════════════════════════════════════════════════════════════════════════════\n"
    cabecalho+="LOG INICIADO EM: $timestamp\n"
    cabecalho+="SCRIPT VERSÃO: 6.0 (Precisa)\n"
    cabecalho+="TERMUX VERSÃO: $(termux-info 2>/dev/null | head -n1)\n"
    cabecalho+="DISPOSITIVO: $(getprop ro.product.manufacturer 2>/dev/null) $(getprop ro.product.model 2>/dev/null)\n"
    cabecalho+="ANDROID: $(getprop ro.build.version.release 2>/dev/null) (API $(getprop ro.build.version.sdk 2>/dev/null))\n"
    cabecalho+="KERNEL: $(uname -r)\n"
    cabecalho+="ARQUITETURA: $(uname -m)\n"
    cabecalho+="NÚCLEOS CPU: $(nproc)\n"
    cabecalho+="MEMÓRIA RAM: $(free -h 2>/dev/null | grep Mem | awk '{print $2}' || echo "N/A")\n"
    cabecalho+="ARMAZENAMENTO TOTAL: $(df -h ~ 2>/dev/null | tail -n1 | awk '{print $2}' || echo "N/A")\n"
    cabecalho+="ARMAZENAMENTO LIVRE: $(df -h ~ 2>/dev/null | tail -n1 | awk '{print $4}' || echo "N/A")\n"
    cabecalho+="BASE_DIR: $BASE_DIR\n"
    cabecalho+="═════════════════════════════════════════════════════════════════════════════════\n\n"

    for log in "$LOG_PRINCIPAL" "$LOG_ERROS" "$LOG_DEBUG" "$LOG_INSTALACAO" "$LOG_MINERACAO" \
                "$LOG_SISTEMA" "$LOG_MONITOR" "$LOG_PERFORMANCE" "$LOG_REDE" "$LOG_COMPILACAO" \
                "$LOG_FALLBACK" "$LOG_METODOS" "$LOG_VERIFICACAO" "$LOG_TESTES" \
                "$LOG_WALLET" "$LOG_POOL" "$LOG_THREADS"; do
        echo -e "$cabecalho" > "$log" 2>/dev/null || true
    done
}

# Função de log universal com timestamp preciso (microssegundos)
log() {
    local nivel="$1"
    local mensagem="$2"
    local arquivo="$3"
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S.%6N")
    local pid=$$
    local funcao="${FUNCNAME[2]:-main}"
    local linha="${BASH_LINENO[1]:-0}"

    local log_entry="[$timestamp] [$nivel] [PID:$pid] [${funcao}:${linha}] $mensagem"

    echo "$log_entry" >> "$arquivo" 2>/dev/null || true
    echo "$log_entry" >> "$LOG_PRINCIPAL" 2>/dev/null || true

    if [[ "$nivel" == "ERRO" || "$nivel" == "CRITICO" ]]; then
        echo "$log_entry" >> "$LOG_ERROS" 2>/dev/null || true
    fi
    if [[ "$nivel" == "DEBUG" && "$DEBUG_MODE" == "1" ]]; then
        echo -e "${DIM}[DEBUG]${RESET} $mensagem"
    fi
}

# Funções de logging específicas (adaptadas)
log_info() { log "INFO" "$1" "$LOG_INSTALACAO"; }
log_sucesso() { log "SUCESSO" "$1" "$LOG_INSTALACAO"; }
log_aviso() { log "AVISO" "$1" "$LOG_INSTALACAO"; }
log_erro() { log "ERRO" "$1" "$LOG_ERROS"; }
log_critico() { log "CRITICO" "$1" "$LOG_ERROS"; exit 1; }
log_debug() { [[ "$DEBUG_MODE" == "1" ]] && log "DEBUG" "$1" "$LOG_DEBUG"; }
log_metodo() { log "METODO" "$1" "$LOG_METODOS"; }
log_compilacao() { log "COMPILACAO" "$1" "$LOG_COMPILACAO"; }
log_fallback() { log "FALLBACK" "$1" "$LOG_FALLBACK"; }
log_performance() { log "PERFORMANCE" "$1" "$LOG_PERFORMANCE"; }
log_rede() { log "REDE" "$1" "$LOG_REDE"; }
log_mineracao() { log "MINERACAO" "$1" "$LOG_MINERACAO"; }
log_verificacao() { log "VERIFICACAO" "$1" "$LOG_VERIFICACAO"; }
log_teste() { log "TESTE" "$1" "$LOG_TESTES"; }

# Funções de output visual (mantidas)
print_msg() { echo -e "${AZUL}[INFO]${RESET} $1"; log_info "$1"; }
print_sucesso() { echo -e "${VERDE}[SUCESSO]${RESET} $1"; log_sucesso "$1"; }
