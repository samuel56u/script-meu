            local wallet=$(cat "$MINER_CONFIG/current_wallet" 2>/dev/null)
            echo "Carteira: ${wallet:0:16}...${wallet: -8}"
        fi
        if [ -f "$MINER_CONFIG/worker.id" ]; then
            echo "Worker ID: $(cat "$MINER_CONFIG/worker.id" 2>/dev/null)"
        fi
        echo ""
        echo "══════════════════════════════════════════════════════════════════"
        
    } > "$stats_file" 2>/dev/null
    
    if [ -f "$stats_file" ]; then
        local size=$(du -h "$stats_file" | cut -f1)
        log "SUCCESS" "Estatísticas exportadas: $(basename "$stats_file") (${size})"
        echo -e "\n${CYAN}Arquivo salvo em:${NC} $stats_file"
        
        # Copiar para o storage do Android se disponível
        if [ -d ~/storage/downloads ]; then
            cp "$stats_file" ~/storage/downloads/ 2>/dev/null
            log "INFO" "Cópia salva em: ~/storage/downloads/$(basename "$stats_file")"
        fi
        
        send_notification "Estatísticas Exportadas" "Relatório gerado com sucesso"
    else
        log "ERROR" "Falha ao exportar estatísticas"
    fi
}

