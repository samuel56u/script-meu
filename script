# ============================================================================
# FUNÇÃO 17: INICIAR MINERAÇÃO
# ============================================================================
start_mining() {
    log "MINER" "Iniciando processo de mineração RandomX..."
    
    # Verificar se já está rodando
    if [ -f "$MINER_CONFIG/mining.pid" ]; then
        local pid=$(cat "$MINER_CONFIG/mining.pid" 2>/dev/null)
        if kill -0 $pid 2>/dev/null 2>&1; then
            log "WARNING" "Mineração já está ativa (PID: $pid)"
            return 0
        else
            rm -f "$MINER_CONFIG/mining.pid"
        fi
    fi
    
    # Verificar XMRig
    if ! check_xmrig; then
        log "INFO" "Instalando XMRig..."
        install_xmrig || return 1
    fi
    
    # Verificar configuração
    if [ ! -f "$MINER_CONFIG/config.json" ]; then
        if [ ! -f "$MINER_CONFIG/current_wallet" ] || [ ! -f "$MINER_CONFIG/current_pool" ]; then
            log "ERROR" "Configure primeiro a carteira e pool"
            return 1
        fi
        WALLET=$(cat "$MINER_CONFIG/current_wallet")
        POOL=$(cat "$MINER_CONFIG/current_pool")
        generate_config "$WALLET" "$POOL"
    fi
    
    # Criar diretório de logs
    mkdir -p "$MINER_LOGS"
    
    # Iniciar minerador
    cd "$MINER_ROOT"
    nohup "$MINER_BIN/xmrig" -c "$MINER_CONFIG/config.json" >> "$MINER_LOGS/xmrig.log" 2>&1 &
    local pid=$!
    
    # Aguardar e verificar
    sleep 3
    if kill -0 $pid 2>/dev/null 2>&1; then
        echo $pid > "$MINER_CONFIG/mining.pid"
        log "SUCCESS" "Mineração RandomX iniciada (PID: $pid)"
        send_notification "RandomX Miner" "Mineração iniciada - PID: $pid"
        collect_stats
    else
        log "ERROR" "Falha ao iniciar mineração"
        tail -20 "$MINER_LOGS/xmrig.log"
        return 1
    fi
}

# ============================================================================
# FUNÇÃO 18: PARAR MINERAÇÃO
# ============================================================================
stop_mining() {
    log "MINER" "Parando mineração..."
    
    if [ ! -f "$MINER_CONFIG/mining.pid" ]; then
        log "WARNING" "Mineração não está ativa"
        return 0
    fi
    
    local pid=$(cat "$MINER_CONFIG/mining.pid")
    
    # Tentar parada graciosa
    if kill -0 $pid 2>/dev/null 2>&1; then
        kill $pid
        sleep 3
        
        # Forçar se necessário
        if kill -0 $pid 2>/dev/null 2>&1; then
            log "WARNING" "Processo não respondeu, forçando parada..."
            kill -9 $pid
            sleep 1
        fi
    fi
    
    rm -f "$MINER_CONFIG/mining.pid"
    log "SUCCESS" "Mineração parada"
    send_notification "RandomX Miner" "Mineração parada"
    
    # Coletar estatísticas finais
    collect_stats
}

# ============================================================================
# FUNÇÃO 19: REINICIAR MINERAÇÃO
# ============================================================================
restart_mining() {
    log "MINER" "Reiniciando mineração..."
    stop_mining
    sleep 2
    start_mining
}

# ============================================================================
# FUNÇÃO 20: STATUS DA MINERAÇÃO
# ============================================================================
mining_status() {
    if [ -f "$MINER_CONFIG/mining.pid" ]; then
