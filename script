mostrar_resumo_preciso() {
    clear
    echo -e "${VERDE}${BOLD}"
    echo "╔═════════════════════════════════════════════════════════════════════════════════╗"
    echo "║                    INSTALAÇÃO PRECISA CONCLUÍDA COM SUCESSO!                    ║"
    echo "╚═════════════════════════════════════════════════════════════════════════════════╝"
    echo -e "${RESET}"
    echo ""
    echo -e "${CIANO}${BOLD}📦 MINERADOR INSTALADO${RESET}"
    echo -e "  Caminho: ${VERDE}$MINER_PATH${RESET}"
    echo -e "  Métodos funcionaram: ${#METODOS_SUCESSO[@]}"
    for metodo in "${METODOS_SUCESSO[@]}"; do
        echo -e "    ${VERDE}✓${RESET} $metodo"
    done
    echo ""
    echo -e "${CIANO}${BOLD}📁 DIRETÓRIOS${RESET}"
    echo -e "  ${AZUL}➜${RESET} Base: $BASE_DIR"
    echo -e "  ${AZUL}➜${RESET} Logs: $LOG_DIR"
    echo -e "  ${AZUL}➜${RESET} Scripts: $SCRIPTS_DIR"
    echo ""
    echo -e "${CIANO}${BOLD}🚀 COMANDOS${RESET}"
    echo -e "  ${VERDE}1.${RESET} Iniciar mineração: ${BOLD}screen -dmS mineracao_precisa $SCRIPTS_DIR/minerar_preciso.sh${RESET}"
    echo -e "  ${VERDE}2.${RESET} Ver mineração: ${BOLD}screen -r mineracao_precisa${RESET}"
    echo -e "  ${VERDE}3.${RESET} Monitor: ${BOLD}$SCRIPTS_DIR/monitor_preciso.sh${RESET}"
    echo -e "  ${VERDE}4.${RESET} Logs: ${BOLD}tail -f $LOG_DIR/mineracao.log${RESET}"
    echo ""
    echo -e "${CIANO}${BOLD}⚙️ CONFIGURAÇÕES${RESET}"
    echo -e "  Carteira: ${AMARELO}bc1qtz2j3ky2nh409w432wh8uyqphhny84a3qhs2tl${RESET}"
    echo -e "  Threads: ${AMARELO}$(nproc)${RESET}"
    echo ""
    echo -e "${CIANO}${BOLD}⚡ INICIANDO MINERAÇÃO AGORA...${RESET}"
    echo ""
    cd "$BASE_DIR"
    screen -dmS mineracao_precisa "$SCRIPTS_DIR/minerar_preciso.sh" "$MINER_PATH"
    sleep 2
    if screen -list | grep -q "mineracao_precisa"; then
        echo -e "${VERDE}✅ Mineração iniciada em segundo plano!${RESET}"
        echo -e "${AMARELO}📺 Para ver ao vivo: screen -r mineracao_precisa${RESET}"
    else
        echo -e "${VERMELHO}❌ Falha ao iniciar. Executando em modo debug...${RESET}"
        "$SCRIPTS_DIR/minerar_preciso.sh" "$MINER_PATH"
    fi
    echo ""
    echo -e "${VERDE}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${VERDE}${BOLD}                    SCRIPT CONCLUÍDO - BOA MINERAÇÃO PRECISA!                   ${RESET}"
    echo -e "${VERDE}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"
}

