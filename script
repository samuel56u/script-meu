# Método 3: Compilar cpuminer (pooler)
metodo3_compilar_pooler() {
    log_metodo "MÉTODO 3: Compilando pooler/cpuminer"
    print_msg "M3: Compilando cpuminer do pooler (pode levar até 30 minutos)"
    cd "$WORK_DIR"
    rm -rf cpuminer_pooler
    git clone https://github.com/pooler/cpuminer.git cpuminer_pooler >> "$LOG_COMPILACAO" 2>&1
    if [ $? -ne 0 ]; then
        log_erro "Falha ao clonar repositório"
        return 1
    fi
    cd cpuminer_pooler
    log_compilacao "Executando autogen.sh..."
    ./autogen.sh >> "$LOG_COMPILACAO" 2>&1
    if [ $? -ne 0 ]; then
        log_erro "Falha no autogen.sh"
        return 1
    fi
    local config_sucesso=0
    local config_flags=(
        "--prefix=$PREFIX CFLAGS='-O2 -march=native'"
        "--prefix=$PREFIX CFLAGS='-O2'"
        "--prefix=$PREFIX"
    )
    for flags in "${config_flags[@]}"; do
        log_compilacao "Tentando configuração: $flags"
        eval ./configure $flags >> "$LOG_COMPILACAO" 2>&1
        if [ $? -eq 0 ]; then
            config_sucesso=1
            break
        fi
    done
    if [ $config_sucesso -eq 0 ]; then
        log_erro "Falha na configuração"
        return 1
    fi
    log_compilacao "Iniciando compilação com $(nproc) threads..."
    timeout $TIMEOUT_COMPILACAO make -j$(nproc) >> "$LOG_COMPILACAO" 2>&1
    local make_status=$?
    if [ $make_status -eq 124 ]; then
        log_erro "Compilação excedeu tempo limite de $TIMEOUT_COMPILACAO segundos"
        return 1
    elif [ $make_status -ne 0 ]; then
        log_erro "Falha na compilação"
        return 1
    fi
    local miner_encontrado=""
    if [ -f minerd ]; then
        miner_encontrado="minerd"
    elif [ -f cpuminer ]; then
        miner_encontrado="cpuminer"
    else
        miner_encontrado=$(find . -type f -executable -name "minerd" -o -name "cpuminer" | head -n1)
    fi
    if [ -n "$miner_encontrado" ]; then
        cp "$miner_encontrado" $PREFIX/bin/cpuminer-pooler
        chmod +x $PREFIX/bin/cpuminer-pooler
        MINER_PATH="$PREFIX/bin/cpuminer-pooler"
        log_compilacao "Minerador compilado: $MINER_PATH"
        if testar_minerador_preciso "$MINER_PATH"; then
            METODOS_SUCESSO+=("M3: pooler compilado")
            return 0
        fi
    fi
    return 1
}

