# TESTE DO MINERADOR
# █████████████████████████████████████████████████████████████████████████████

testar_minerador() {
    local miner="$1"
    print_msg "Testando minerador: $miner"
    
    # Verifica se o arquivo existe
    if [ ! -f "$miner" ]; then
        print_erro "Arquivo não encontrado"
        return 1
    fi
    
    # Verifica permissão de execução
    if [ ! -x "$miner" ]; then
        chmod +x "$miner"
    fi
    
    # Tenta obter versão
    if "$miner" --version > /dev/null 2>&1; then
        print_sucesso "Minerador responde ao --version"
        return 0
    fi
    
    # Tenta --help
    if "$miner" --help > /dev/null 2>&1; then
        print_sucesso "Minerador responde ao --help"
        return 0
    fi
    
    # Tenta uma conexão rápida (sem minerar)
    timeout 5 "$miner" -a sha256d -o stratum+tcp://sha256.auto.nicehash.com:9200 -u teste -p x -t 1 > /dev/null 2>&1 &
    local pid=$!
    sleep 3
    kill $pid 2>/dev/null
    
    if [ $? -eq 0 ]; then
        print_sucesso "Minerador conseguiu conectar"
        return 0
    fi
    
    return 1
}

