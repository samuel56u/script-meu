# ============================================================================
# FUNÇÃO 02: LOG AVANÇADO (CORRIGIDO - SEM STAT)
# ============================================================================
log() {
    local level="$1"
    local message="$2"
    local timestamp="[$(date '+%Y-%m-%d %H:%M:%S')]"
    local log_file="$MINER_LOGS/system.log"
    
    # Escrever no arquivo principal
    echo "${timestamp} [${level}] ${message}" >> "$log_file" 2>/dev/null
    
    # Logs separados por nível
    case "$level" in
        "ERROR")   echo "${timestamp} [ERROR] ${message}" >> "$MINER_LOGS/error.log" 2>/dev/null ;;
        "WARNING") echo "${timestamp} [WARNING] ${message}" >> "$MINER_LOGS/warning.log" 2>/dev/null ;;
        "SUCCESS") echo "${timestamp} [SUCCESS] ${message}" >> "$MINER_LOGS/success.log" 2>/dev/null ;;
        "DEBUG")   echo "${timestamp} [DEBUG] ${message}" >> "$MINER_LOGS/debug.log" 2>/dev/null ;;
    esac
    
    # Rotação de logs (corrigido - usa wc em vez de stat)
    if [ -f "$log_file" ]; then
        local size=$(wc -c < "$log_file" 2>/dev/null || echo "0")
        if [ "$size" -gt $LOG_ROTATE_SIZE ]; then
            local backup_file="${log_file}.$(date '+%Y%m%d%H%M%S')"
            mv "$log_file" "$backup_file" 2>/dev/null
            gzip "$backup_file" 2>/dev/null &
            
            # Manter apenas os últimos N arquivos
            ls -t "$MINER_LOGS"/system.log.*.gz 2>/dev/null | tail -n +$((LOG_ROTATE_FILES + 1)) | xargs rm -f 2>/dev/null
        fi
    fi
    
    # Saída colorida no terminal
    case "$level" in
        "ERROR")   echo -e "${RED}[ERROR]${NC} ${message}" ;;
        "WARNING") echo -e "${YELLOW}[WARNING]${NC} ${message}" ;;
        "SUCCESS") echo -e "${GREEN}[SUCCESS]${NC} ${message}" ;;
        "INFO")    echo -e "${CYAN}[INFO]${NC} ${message}" ;;
        "DEBUG")   echo -e "${DIM}[DEBUG]${NC} ${message}" ;;
        "MINER")   echo -e "${LIME}[MINER]${NC} ${message}" ;;
        "POOL")    echo -e "${BLUE}[POOL]${NC} ${message}" ;;
        "WALLET")  echo -e "${GOLD}[WALLET]${NC} ${message}" ;;
        "RANDOMX") echo -e "${PURPLE}[RANDOMX]${NC} ${message}" ;;
        "BENCH")   echo -e "${MAGENTA}[BENCH]${NC} ${message}" ;;
        "SYSTEM")  echo -e "${WHITE}[SYSTEM]${NC} ${message}" ;;
        "TERMUX")  echo -e "${ORANGE}[TERMUX]${NC} ${message}" ;;
        *)         echo -e "${WHITE}[${level}]${NC} ${message}" ;;
    esac
}

# ============================================================================
# FUNÇÃO 03: GERAR UUID (CORRIGIDO - SEM /PROC/SYS)
# ============================================================================
generate_uuid() {
    # Gerar UUID manualmente (compatível com Android)
    local uuid=$(date +%s%N 2>/dev/null)
    if [ -z "$uuid" ]; then
        uuid=$(date +%s)$RANDOM
    fi
    
    # Formatar como UUID (8-4-4-4-12)
    local time_low=$(echo "$uuid" | md5sum 2>/dev/null | cut -c1-8 || echo "$RANDOM$RANDOM" | cut -c1-8)
    local time_mid=$(echo "$uuid" | md5sum 2>/dev/null | cut -c9-12 || echo "$RANDOM" | cut -c1-4)
    local time_high=$(echo "$uuid" | md5sum 2>/dev/null | cut -c13-16 || echo "$RANDOM" | cut -c1-4)
    local clock_seq=$(echo "$uuid" | md5sum 2>/dev/null | cut -c17-20 || echo "$RANDOM" | cut -c1-4)
    local node=$(echo "$uuid" | md5sum 2>/dev/null | cut -c21-32 || echo "$RANDOM$RANDOM$RANDOM" | cut -c1-12)
    
    echo "${time_low}-${time_mid}-${time_high}-${clock_seq}-${node}"
}

# ============================================================================
# FUNÇÃO 04: TIMESTAMP MILISSEGUNDOS (CORRIGIDO)
# ============================================================================
timestamp_ms() {
    # Android não tem %N em alguns casos
    if date +%s%N 2>/dev/null | grep -q 'N'; then
        echo $(date +%s)000
    else
        date +%s%N 2>/dev/null | cut -c1-13 || echo "$(date +%s)000"
    fi
}

# ============================================================================
# FUNÇÃO 05: TIMESTAMP SEGUNDOS
# ============================================================================
timestamp_sec() {
    date +%s 2>/dev/null || echo "0"
}

# ============================================================================
# FUNÇÃO 06: FORMATAR TEMPO
# ============================================================================
format_time() {
    local seconds=$1
    if [ -z "$seconds" ] || [ "$seconds" -lt 0 ]; then
        seconds=0
    fi
    local hours=$((seconds / 3600))
    local minutes=$(((seconds % 3600) / 60))
    local secs=$((seconds % 60))
    printf "%02d:%02d:%02d" $hours $minutes $secs
}

# ============================================================================
# FUNÇÃO 07: FORMATAR HASH (CORRIGIDO - COM FALLBACK SEM BC)
# ============================================================================
format_hash() {
    local hash=$1
    if [ -z "$hash" ] || [ "$hash" = "0" ]; then
        echo "0 H/s"
        return
    fi
    
    # Remover parte decimal se existir
    hash=$(echo "$hash" | cut -d. -f1)
    
    if command -v bc >/dev/null 2>&1; then
        if (( $(echo "$hash > 1000000" | bc -l 2>/dev/null) )); then
            echo "$(echo "scale=2; $hash/1000000" | bc 2>/dev/null) MH/s"
        elif (( $(echo "$hash > 1000" | bc -l 2>/dev/null) )); then
            echo "$(echo "scale=2; $hash/1000" | bc 2>/dev/null) KH/s"
        else
            echo "$(echo "scale=2; $hash" | bc 2>/dev/null) H/s"
        fi
    else
        # Fallback sem bc
        if [ "$hash" -gt 1000000 ]; then
            local mhs=$((hash / 1000000))
            local remainder=$(( (hash % 1000000) / 100000 ))
            echo "${mhs}.${remainder} MH/s"
        elif [ "$hash" -gt 1000 ]; then
            local khs=$((hash / 1000))
            local remainder=$(( (hash % 1000) / 100 ))
            echo "${khs}.${remainder} KH/s"
        else
            echo "${hash} H/s"
        fi
    fi
}

# ============================================================================
# FUNÇÃO 08: DETECTAR HARDWARE COMPLETO (CORRIGIDO PARA ANDROID)
# ============================================================================
detect_hardware() {
    log "SYSTEM" "Iniciando detecção detalhada de hardware..."
    
    # CPU Info (Android)
    if [ -f /proc/cpuinfo ]; then
        export CPU_MODEL=$(grep "Processor" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ //')
        if [ -z "$CPU_MODEL" ]; then
            export CPU_MODEL=$(grep "model name" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ //')
        fi
        if [ -z "$CPU_MODEL" ]; then
            export CPU_MODEL=$(grep "Hardware" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ //')
        fi
        if [ -z "$CPU_MODEL" ]; then
            export CPU_MODEL="Unknown ARM Processor"
        fi
        
        export CPU_VENDOR=$(grep "vendor_id" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ //' || echo "ARM")
        export CPU_CORES_PHYSICAL=$(grep "cpu cores" /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | sed 's/^ //' || echo "$CPU_CORES")
    else
        export CPU_MODEL="Unknown ARM Processor"
        export CPU_VENDOR="ARM"
        export CPU_CORES_PHYSICAL="$CPU_CORES"
    fi
    
    export CPU_CORES_LOGICAL=$(nproc 2>/dev/null || echo "4")
    
    # Frequência CPU (Android)
    export CPU_FREQ_MIN=0
    export CPU_FREQ_MAX=0
    export CPU_FREQ_CUR=0
    export CPU_GOVERNOR="unknown"
    
    if [ -d /sys/devices/system/cpu ]; then
        for cpu in /sys/devices/system/cpu/cpu*/cpufreq/; do
            if [ -f "${cpu}cpuinfo_min_freq" ]; then
                local min=$(cat "${cpu}cpuinfo_min_freq" 2>/dev/null | awk '{print int($1/1000)}')
                [ "$min" -gt "$CPU_FREQ_MIN" ] && export CPU_FREQ_MIN=$min
            fi
            if [ -f "${cpu}cpuinfo_max_freq" ]; then
                local max=$(cat "${cpu}cpuinfo_max_freq" 2>/dev/null | awk '{print int($1/1000)}')
                [ "$max" -gt "$CPU_FREQ_MAX" ] && export CPU_FREQ_MAX=$max
            fi
            if [ -f "${cpu}scaling_cur_freq" ]; then
                local cur=$(cat "${cpu}scaling_cur_freq" 2>/dev/null | awk '{print int($1/1000)}')
                [ "$cur" -gt "$CPU_FREQ_CUR" ] && export CPU_FREQ_CUR=$cur
            fi
            if [ -f "${cpu}scaling_governor" ] && [ "$CPU_GOVERNOR" = "unknown" ]; then
                export CPU_GOVERNOR=$(cat "${cpu}scaling_governor" 2>/dev/null || echo "unknown")
            fi
            break
        done
    fi
    
    # Memória (Android)
    if [ -f /proc/meminfo ]; then
        local mem_total_kb=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}' || echo "0")
        local mem_free_kb=$(grep MemFree /proc/meminfo 2>/dev/null | awk '{print $2}' || echo "0")
        local mem_available_kb=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print $2}' || echo "$mem_free_kb")
        
        export MEM_TOTAL=$((mem_total_kb / 1024))
        export MEM_FREE=$((mem_free_kb / 1024))
        export MEM_AVAILABLE=$((mem_available_kb / 1024))
        
        # Swap (se existir)
        local swap_total_kb=$(grep SwapTotal /proc/meminfo 2>/dev/null | awk '{print $2}' || echo "0")
        local swap_free_kb=$(grep SwapFree /proc/meminfo 2>/dev/null | awk '{print $2}' || echo "0")
        export MEM_SWAP_TOTAL=$((swap_total_kb / 1024))
        export MEM_SWAP_FREE=$((swap_free_kb / 1024))
    else
        export MEM_TOTAL=2048
        export MEM_FREE=1024
        export MEM_AVAILABLE=1024
        export MEM_SWAP_TOTAL=0
        export MEM_SWAP_FREE=0
    fi
    
    # HugePages (não disponível no Android)
    export HUGEPAGES_TOTAL=0
    export HUGEPAGES_SIZE=0
    
    # AES-NI / ARM CRC
    if [ -f /proc/cpuinfo ]; then
        if grep -q aes /proc/cpuinfo 2>/dev/null; then
            export AES_NI_SUPPORTED=true
        else
            export AES_NI_SUPPORTED=false
        fi
        
        if grep -q "crc32" /proc/cpuinfo 2>/dev/null; then
            export ARM_CRC=true
        else
            export ARM_CRC=false
        fi
    else
        export AES_NI_SUPPORTED=false
        export ARM_CRC=false
    fi
    
    # Temperatura (Android)
    export THERMAL_ZONES=0
    export CPU_TEMP=35
    
    if [ -d /sys/class/thermal ]; then
        export THERMAL_ZONES=$(ls -d /sys/class/thermal/thermal_zone* 2>/dev/null | wc -l)
        for zone in /sys/class/thermal/thermal_zone*/temp; do
            if [ -f "$zone" ]; then
                local temp=$(cat "$zone" 2>/dev/null | awk '{print int($1/1000)}')
                if [ -n "$temp" ] && [ "$temp" -gt "$CPU_TEMP" ]; then
                    export CPU_TEMP=$temp
                fi
                break
            fi
        done
    fi
    
    # Armazenamento (Android)
    export STORAGE_TOTAL=0
    export STORAGE_USED=0
    export STORAGE_FREE=0
    export STORAGE_PERCENT=0
    
    if command -v df >/dev/null 2>&1; then
        local df_output=$(df -P /data 2>/dev/null | tail -1)
        if [ -n "$df_output" ]; then
            export STORAGE_TOTAL=$(echo "$df_output" | awk '{print $2}' || echo "0")
            export STORAGE_USED=$(echo "$df_output" | awk '{print $3}' || echo "0")
            export STORAGE_FREE=$(echo "$df_output" | awk '{print $4}' || echo "0")
            export STORAGE_PERCENT=$(echo "$df_output" | awk '{print $5}' | sed 's/%//' || echo "0")
        fi
    fi
    
    log "HARDWARE" "CPU: $CPU_MODEL ($CPU_CORES_LOGICAL cores)"
    log "HARDWARE" "Frequência: ${CPU_FREQ_MIN}MHz - ${CPU_FREQ_MAX}MHz (atual: ${CPU_FREQ_CUR}MHz)"
    log "HARDWARE" "Memória: ${MEM_TOTAL}MB total, ${MEM_AVAILABLE}MB disponível"
    log "HARDWARE" "AES-NI: $AES_NI_SUPPORTED | ARM CRC: $ARM_CRC"
    log "HARDWARE" "Temperatura: ${CPU_TEMP}°C"
    
    # Ajustar modo RandomX baseado na RAM
    if [ "$MEM_TOTAL" -lt 2048 ]; then
        export RANDOMX_MODE="light"
        log "RANDOMX" "Modo light ativado automaticamente (pouca RAM)"
    elif [ "$MEM_TOTAL" -gt 3000 ]; then
        export RANDOMX_MODE="fast"
        log "RANDOMX" "Modo fast ativado automaticamente (RAM suficiente)"
    fi
    
    # 1GB Pages sempre false no Android
    export RANDOMX_1GB_PAGES=false
    log "RANDOMX" "1GB Pages: não suportado no Android"
}

# ============================================================================
# FUNÇÃO 09: VERIFICAR PERMISSÕES TERMUX (CORRIGIDO)
# ============================================================================
check_termux_permissions() {
    log "TERMUX" "Verificando permissões do Termux..."
    
    # Verificar storage
    if [ ! -d ~/storage ]; then
        log "WARNING" "Storage não configurado. Executando termux-setup-storage..."
        termux-setup-storage 2>/dev/null
        sleep 3
    fi
    
    # Verificar termux-api
    if ! command -v termux-api > /dev/null 2>&1; then
        log "WARNING" "Termux:API não instalado. Instalando..."
        pkg install -y termux-api > /dev/null 2>&1
    else
        log "SUCCESS" "Termux:API instalado"
    fi
    
    # Wake lock
    if command -v termux-wake-lock > /dev/null 2>&1; then
        log "SUCCESS" "Wake lock disponível"
    fi
    
    # Bateria
    if command -v termux-battery-status > /dev/null 2>&1; then
        local battery=$(termux-battery-status 2>/dev/null)
        if [ -n "$battery" ] && [ "$battery" != "{}" ]; then
            local percent=$(echo "$battery" | grep -o '"percentage":[0-9]*' | cut -d: -f2)
            local status=$(echo "$battery" | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
            log "BATTERY" "Nível: ${percent:-?}% | Status: ${status:-?}"
        fi
    fi
    
    # Notificações
    if command -v termux-notification > /dev/null 2>&1; then
        log "SUCCESS" "Notificações disponíveis"
    fi
    
    # Vibrar
    if command -v termux-vibrate > /dev/null 2>&1; then
        log "SUCCESS" "Vibração disponível"
    fi
    
    log "TERMUX" "Verificação de permissões concluída"
}

# ============================================================================
# FUNÇÃO 10: ENVIAR NOTIFICAÇÃO (TERMUX)
# ============================================================================
send_notification() {
    local title="$1"
    local content="$2"
    local priority="${3:-normal}"
    
    if command -v termux-notification > /dev/null 2>&1; then
        termux-notification \
            --title "$title" \
            --content "$content" \
            --priority "$priority" \
            --id "randomx_miner" \
            --vibrate 200 \
            --sound 2>/dev/null
        log "NOTIFICATION" "$title: $content"
    fi
}

# ============================================================================
# FUNÇÃO 11: VIBRAR DISPOSITIVO (TERMUX)
# ============================================================================
vibrate_device() {
    local duration="${1:-500}"
    if command -v termux-vibrate > /dev/null 2>&1; then
        termux-vibrate -d "$duration" 2>/dev/null
        log "HARDWARE" "Vibração ativada por ${duration}ms"
    fi
}

# ============================================================================
# FUNÇÃO 12: TEXTO PARA FALA (TERMUX)
# ============================================================================
speak_text() {
    local text="$1"
    if command -v termux-tts-speak > /dev/null 2>&1; then
        termux-tts-speak "$text" 2>/dev/null
        log "TERMUX" "Texto falado: $text"
    fi
}

# ============================================================================
# FUNÇÃO 13: VERIFICAR DEPENDÊNCIAS (CORRIGIDO PARA TERMUX)
# ============================================================================
check_dependencies() {
    log "SYSTEM" "Verificando dependências básicas..."
    
    # Lista completa de dependências
    local deps=(
        "wget"
        "curl"
        "tar"
        "gzip"
        "nano"
        "bc"
        "termux-api"
        "termux-tools"
        "openssl"
        "libuv"
    )
    
    local missing=()
    local pkg_list=$(pkg list-installed 2>/dev/null)
    
    # Verificar cada dependência
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" > /dev/null 2>&1; then
            # Verificar se é pacote Termux especial
            case "$dep" in
                termux-api|termux-tools)
                    if ! echo "$pkg_list" | grep -q "^$dep"; then
                        missing+=("$dep")
                    fi
                    ;;
                *)
                    missing+=("$dep")
                    ;;
            esac
        fi
    done
    
    # Instalar dependências faltantes
    if [ ${#missing[@]} -gt 0 ]; then
        log "INFO" "Instalando dependências: ${missing[*]}"
        pkg update -y > /dev/null 2>&1
        pkg install -y "${missing[@]}" > /dev/null 2>&1
    fi
    
    # Verificação final
    for dep in "${deps[@]}"; do
        if command -v "$dep" > /dev/null 2>&1; then
            log "SUCCESS" "$dep instalado"
        else
            log "WARNING" "$dep não encontrado (funcionalidade limitada)"
        fi
    done
    
    # Verificar md5sum (usado para UUID)
    if ! command -v md5sum > /dev/null 2>&1; then
        pkg install -y md5sum > /dev/null 2>&1 || true
    fi
}

# ============================================================================
# FUNÇÃO 14: DETECTAR ARQUITETURA (CORRIGIDO)
# ============================================================================
detect_architecture() {
    export ARCH=$(uname -m)
    export ARCH_ALT=""
    
    case "$ARCH" in
        aarch64|arm64|armv8l)
            export ARCH_TYPE="arm64"
            export XMRIG_ARCH="arm64"
            export XMRIG_FILE="xmrig-6.21.0-android-arm64.tar.gz"
            export XMRIG_BINARY="xmrig"
            export XMRIG_URL="https://github.com/xmrig/xmrig/releases/download/v6.21.0/xmrig-6.21.0-android-arm64.tar.gz"
            ;;
        armv7l|armhf|armv8l|arm)
            export ARCH_TYPE="arm32"
            export XMRIG_ARCH="armv7"
            export XMRIG_FILE="xmrig-6.21.0-android-armv7.tar.gz"
            export XMRIG_BINARY="xmrig"
            export XMRIG_URL="https://github.com/xmrig/xmrig/releases/download/v6.21.0/xmrig-6.21.0-android-armv7.tar.gz"
            ;;
        x86_64|amd64)
            export ARCH_TYPE="x64"
            export XMRIG_ARCH="x86_64"
            export XMRIG_FILE="xmrig-6.21.0-android-x86_64.tar.gz"
            export XMRIG_BINARY="xmrig"
            export XMRIG_URL="https://github.com/xmrig/xmrig/releases/download/v6.21.0/xmrig-6.21.0-android-x86_64.tar.gz"
            ;;
        i*86|i686)
            export ARCH_TYPE="x86"
            export XMRIG_ARCH="i686"
            export XMRIG_FILE="xmrig-6.21.0-android-i686.tar.gz"
            export XMRIG_BINARY="xmrig"
            export XMRIG_URL="https://github.com/xmrig/xmrig/releases/download/v6.21.0/xmrig-6.21.0-android-i686.tar.gz"
            ;;
        *)
            export ARCH_TYPE="unknown"
            export XMRIG_ARCH=""
            export XMRIG_FILE=""
            export XMRIG_BINARY=""
            export XMRIG_URL=""
            ;;
    esac
    
    log "SYSTEM" "Arquitetura detectada: $ARCH ($ARCH_TYPE)"
