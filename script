    echo -e "${CIANO}${BOLD}📊 LOGS DISPONÍVEIS${RESET}"
    ls -la ~/mineracao/logs/ 2>/dev/null | grep -v total | awk '{print "  " $9 " (" $5 " bytes)"}'
    echo ""
    
    echo -e "${CIANO}${BOLD}⚡ INICIANDO MINERAÇÃO AGORA...${RESET}"
    echo ""
    
    # Inicia a mineração
    cd ~/mineracao
    screen -dmS mineracao ./scripts/minerar_principal.sh "$MINER_PATH"
    sleep 2
    
    if screen -list | grep -q "mineracao"; then
        echo -e "${VERDE}✅ Mineração iniciada em segundo plano!${RESET}"
        echo -e "${AMARELO}📺 Para ver ao vivo: screen -r mineracao${RESET}"
    else
        echo -e "${VERMELHO}❌ Falha ao iniciar. Iniciando em modo debug...${RESET}"
        ./scripts/minerar_principal.sh "$MINER_PATH"
    fi
    
    echo ""
    echo -e "${VERDE}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"
    echo -e "${VERDE}${BOLD}                    SCRIPT CONCLUÍDO - BOA MINERAÇÃO!                           ${RESET}"
    echo -e "${VERDE}${BOLD}═════════════════════════════════════════════════════════════════════════════════${RESET}"
}

