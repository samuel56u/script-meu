    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 57: UPTIME DA MINERAÇÃO (CORRIGIDO)
# ============================================================================
mining_uptime() {
    if [ -f "$MINER_CONFIG/miner.pid" ]; then
        local pid=$(cat "$MINER_CONFIG/miner.pid" 2>/dev/null)
        if kill -0 "$pid" 2>/dev/null; then
            # Usar ps com formato compatível com Android
            local start_time=$(ps -p "$pid" -o start= 2>/dev/null | tr -d ' ')
            if [ -n "$start_time" ]; then
                local now=$(date +%s)
                local start_epoch=$(date -d "$start_time" +%s 2>/dev/null)
                if [ -n "$start_epoch" ]; then
                    echo $((now - start_epoch))
                else
                    # Fallback: verificar se o processo existe
                    if [ -d "/proc/$pid" ]; then
                        local uptime=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
                        echo "${uptime:-0}"
                    else
                        echo "0"
                    fi
                fi
            else
                echo "0"
            fi
        else
            echo "0"
        fi
    else
        echo "0"
    fi
}

# ============================================================================
# FUNÇÃO 58: COLETAR ESTATÍSTICAS
# ============================================================================
collect_stats() {
    mkdir -p "$MINER_STATS" 2>/dev/null
    
    local timestamp=$(timestamp_sec)
    local hashrate=$(current_hashrate)
    local accepted=$(accepted_shares)
    local rejected=$(rejected_shares)
    local diff=$(current_diff)
    local uptime=$(mining_uptime)
    
    echo "$hashrate" > "$MINER_STATS/hashrate" 2>/dev/null
    echo "$accepted" > "$MINER_STATS/accepted" 2>/dev/null
    echo "$rejected" > "$MINER_STATS/rejected" 2>/dev/null
    echo "$diff" > "$MINER_STATS/difficulty" 2>/dev/null
    echo "$uptime" > "$MINER_STATS/uptime" 2>/dev/null
    
    echo "$timestamp,$hashrate,$accepted,$rejected,$diff" >> "$MINER_STATS/history.csv" 2>/dev/null
    
    if [ -f "$MINER_STATS/history.csv" ]; then
        tail -1000 "$MINER_STATS/history.csv" > "$MINER_STATS/history.csv.tmp" 2>/dev/null
        mv "$MINER_STATS/history.csv.tmp" "$MINER_STATS/history.csv" 2>/dev/null
    fi
}

# ============================================================================
# FUNÇÃO 59: MONITOR EM TEMPO REAL (CORRIGIDO)
# ============================================================================
live_monitor() {
    clear
    echo -e "${PURPLE}${BOLD}"
    echo "╔══════════════════════════════════════════════════════════════════╗"
    echo "║               RANDOMX LIVE MONITOR - TERMUX                      ║"
    echo "╚══════════════════════════════════════════════════════════════════╝"
    echo -e "${NC}"
    
    local refresh=5
    local count=0
    
    while true; do
        if [ $((count % 3)) -eq 0 ]; then
            collect_stats
        fi
        
        echo -ne "\033[2J\033[H"
        
        echo -e "${PURPLE}══════════════════════════════════════════════════════════════════${NC}"
        echo -e "${WHITE}  RANDOMX LIVE MONITOR - $(date '+%Y-%m-%d %H:%M:%S')${NC}"
        echo -e "${PURPLE}══════════════════════════════════════════════════════════════════${NC}\n"
        
        echo -ne "${WHITE}Status:${NC} "
        if [ -f "$MINER_CONFIG/miner.pid" ]; then
            local pid=$(cat "$MINER_CONFIG/miner.pid" 2>/dev/null)
            if kill -0 "$pid" 2>/dev/null; then
                echo -e "${GREEN}ATIVO${NC} (PID: $pid)"
            else
                echo -e "${RED}INATIVO${NC}"
                rm -f "$MINER_CONFIG/miner.pid" 2>/dev/null
            fi
        else
            echo -e "${RED}INATIVO${NC}"
        fi
        
        local hashrate=$(current_hashrate)
        local accepted=$(accepted_shares)
        local rejected=$(rejected_shares)
        local rate=$(acceptance_rate)
        local diff=$(current_diff)
        local uptime=$(mining_uptime)
        
        echo -e "${WHITE}Hashrate:${NC} $(format_hash $hashrate)"
        echo -e "${WHITE}Hashrate Médio:${NC} $(format_hash $(average_hashrate))"
        echo -e "${WHITE}Shares:${NC} ${GREEN}✓ $accepted${NC} | ${RED}✗ $rejected${NC} | Taxa: ${rate}%"
        echo -e "${WHITE}Dificuldade:${NC} $diff"
        echo -e "${WHITE}Tempo de Execução:${NC} $(format_time $uptime)"
        
        if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
            local temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{print int($1/1000)}')
            if [ -n "$temp" ] && [ "$temp" -gt 70 ]; then
                echo -e "${WHITE}Temperatura:${NC} ${RED}${temp}°C (ALTA)${NC}"
            else
                echo -e "${WHITE}Temperatura:${NC} ${temp:-?}°C"
            fi
        fi
        
        if command -v termux-battery-status > /dev/null 2>&1; then
            local battery=$(termux-battery-status 2>/dev/null)
            if [ -n "$battery" ] && [ "$battery" != "{}" ]; then
                local percent=$(echo "$battery" | grep -o '"percentage":[0-9]*' | cut -d: -f2)
                local status=$(echo "$battery" | grep -o '"status":"[^"]*"' | cut -d: -f2 | tr -d '"')
                if [ -n "$percent" ]; then
                    if [ "$percent" -lt 20 ] && [ "$status" != "CHARGING" ]; then
                        echo -e "${WHITE}Bateria:${NC} ${RED}${percent}% (${status})${NC}"
                    else
                        echo -e "${WHITE}Bateria:${NC} ${percent}% (${status})"
                    fi
                fi
            fi
        fi
        
        if [ -f "$MINER_CONFIG/current_pool" ]; then
            local pool=$(cat "$MINER_CONFIG/current_pool" 2>/dev/null)
            echo -e "${WHITE}Pool:${NC} $pool"
        fi
        
        echo -e "\n${WHITE}Últimas atividades:${NC}"
        tail -5 "$MINER_LOGS/xmrig.log" 2>/dev/null | while read -r line; do
            if echo "$line" | grep -q "accepted"; then
                echo -e "  ${GREEN}✓${NC} ${line:0:70}..."
            elif echo "$line" | grep -q "rejected"; then
                echo -e "  ${RED}✗${NC} ${line:0:70}..."
            elif echo "$line" | grep -q "speed"; then
                echo -e "  ${CYAN}⚡${NC} ${line:0:70}..."
            else
                echo -e "  ${DIM}${line:0:70}...${NC}"
            fi
        done
        
        echo -e "\n${DIM}Pressione Ctrl+C para sair do monitor${NC}"
        echo -e "${DIM}Atualizando a cada ${refresh} segundos...${NC}"
        
        sleep $refresh
        count=$((count + 1))
    done
}

# ============================================================================
# FUNÇÃO 60: BENCHMARK RANDOMX (CORRIGIDO)
# ============================================================================
run_benchmark() {
    log "BENCH" "Iniciando benchmark RandomX..."
    
    if ! check_xmrig; then
        install_xmrig_all_methods || return 1
    fi
    
    local bench_time=30
    local bench_file="$MINER_TEMP/benchmark_$(date +%s).log"
    
    echo -e "\n${CYAN}Executando benchmark RandomX por ${bench_time} segundos...${NC}\n"
    
    "$MINER_BIN/xmrig" --bench=1M --randomx-mode="$RANDOMX_MODE" --print-time=10 > "$bench_file" 2>&1 &
    local bench_pid=$!
    
    for i in $(seq 1 $((bench_time / 10))); do
        echo -ne "Progresso: $((i*33))% ["
        for j in $(seq 1 $i); do echo -n "#"; done
        for j in $(seq $i 3); do echo -n " "; done
        echo -ne "]\r"
        sleep 10
    done
    echo ""
    
    kill "$bench_pid" 2>/dev/null
    sleep 2
    
    local hashrate=$(grep -o "totals.*" "$bench_file" 2>/dev/null | grep -oE "[0-9]+\.[0-9]+" | head -1)
    local min_hash=$(grep -o "min [0-9]+\.[0-9]+" "$bench_file" 2>/dev/null | grep -oE "[0-9]+\.[0-9]+" | head -1)
    local max_hash=$(grep -o "max [0-9]+\.[0-9]+" "$bench_file" 2>/dev/null | grep -oE "[0-9]+\.[0-9]+" | head -1)
    
    if [ -n "$hashrate" ]; then
        echo -e "\n${GREEN}═══════════════════════════════════════════${NC}"
        echo -e "${WHITE}RESULTADOS DO BENCHMARK RANDOMX:${NC}"
        echo -e "${GREEN}═══════════════════════════════════════════${NC}"
        echo -e "Hashrate Médio: ${BOLD}$(format_hash $hashrate)${NC}"
        echo -e "Hashrate Mínimo: $(format_hash ${min_hash:-0})"
        echo -e "Hashrate Máximo: $(format_hash ${max_hash:-0})"
        echo ""
        
        echo "$hashrate" > "$MINER_STATS/benchmark" 2>/dev/null
        echo "$(date +%s),$hashrate,$min_hash,$max_hash" >> "$MINER_STATS/benchmarks.csv" 2>/dev/null
        
        log "BENCH" "Benchmark concluído: $(format_hash $hashrate)"
    else
        log "ERROR" "Falha ao executar benchmark"
        cat "$bench_file" 2>/dev/null
    fi
}

# ============================================================================
# FUNÇÃO 61: TESTAR LATÊNCIA DAS POOLS (CORRIGIDO)
# ============================================================================
test_pools_latency() {
    echo -e "\n${CYAN}Testando latência das pools RandomX...${NC}"
    echo "══════════════════════════════════════════════════════════════════"
    
    local results=()
    local i=1
    
    for pool in "${POOLS[@]}"; do
        local host=$(echo "$pool" | cut -d: -f1)
        local port=$(echo "$pool" | cut -d: -f2)
        
        echo -ne "Pool $i: $pool ... "
        
        # Ping (adaptado para Android)
        local ping_time=""
        if command -v ping > /dev/null 2>&1; then
            ping_time=$(ping -c 1 -W 2 "$host" 2>/dev/null | grep 'time=' | head -1 | sed 's/.*time=\([0-9.]*\).*/\1/')
        fi
        
        if [ -n "$ping_time" ]; then
            echo -e "${GREEN}${ping_time}ms${NC}"
            results+=("$ping_time:$pool")
        else
            # Tentar conexão TCP com timeout
            if command -v nc > /dev/null 2>&1; then
                if nc -z -w 2 "$host" "$port" 2>/dev/null; then
                    echo -e "${YELLOW}conecta (ping falhou)${NC}"
                    results+=("999:$pool")
                else
                    echo -e "${RED}falhou${NC}"
                fi
            elif command -v timeout > /dev/null 2>&1 && command -v telnet > /dev/null 2>&1; then
                if timeout 2 telnet "$host" "$port" 2>&1 | grep -q "Connected"; then
                    echo -e "${YELLOW}conecta (ping falhou)${NC}"
                    results+=("999:$pool")
                else
                    echo -e "${RED}falhou${NC}"
                fi
            else
                echo -e "${RED}falhou (sem ferramentas)${NC}"
            fi
        fi
        
        i=$((i + 1))
    done
    
    echo "══════════════════════════════════════════════════════════════════"
    
    if [ ${#results[@]} -gt 0 ]; then
        echo -e "\n${GREEN}Top 5 pools mais rápidas:${NC}"
        printf '%s\n' "${results[@]}" 2>/dev/null | sort -n | head -5 | while IFS=: read -r lat pool; do
            echo "  $pool - ${lat}ms"
        done
    else
        echo -e "\n${RED}Nenhuma pool respondeu aos testes${NC}"
    fi
}

# ============================================================================
# FUNÇÃO 62: TROCAR MODO RANDOMX
# ============================================================================
change_randomx_mode() {
    echo -e "\n${CYAN}Configuração do Modo RandomX${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Modos disponíveis para Android:"
    echo "  1) light - Economia de memória (recomendado)"
    echo "             • Usa menos memória RAM"
    echo "             • Ideal para dispositivos com <3GB RAM"
    echo "             • Menor consumo de bateria"
    echo ""
    echo "  2) fast  - Máximo desempenho"
    echo "             • Requer 3GB+ RAM disponível"
    echo "             • Melhor hashrate"
    echo "             • Maior consumo de bateria"
    echo ""
    echo "  3) auto  - Automático (deixa o XMRig decidir)"
    echo ""
    read -p "Escolha (1-3): " mode_choice
    
    case $mode_choice in
        1) 
            export RANDOMX_MODE="light"
            log "RANDOMX" "Modo alterado para: light (economia)"
            ;;
        2) 
            if [ "$MEM_TOTAL" -lt 3000 ]; then
                echo -e "${YELLOW}Aviso: Seu dispositivo tem apenas ${MEM_TOTAL}MB RAM${NC}"
                echo -e "O modo fast pode não funcionar corretamente."
                read -p "Continuar mesmo assim? (s/n): " confirm
                if [ "$confirm" = "s" ] || [ "$confirm" = "S" ]; then
                    export RANDOMX_MODE="fast"
                    log "RANDOMX" "Modo alterado para: fast (desempenho)"
                fi
            else
                export RANDOMX_MODE="fast"
                log "RANDOMX" "Modo alterado para: fast (desempenho)"
            fi
            ;;
        3) 
            export RANDOMX_MODE="auto"
            log "RANDOMX" "Modo alterado para: auto (automático)"
            ;;
        *) 
            log "ERROR" "Opção inválida"
            return
            ;;
    esac
    
    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"mode\": \"[^\"]*\"/\"mode\": \"$RANDOMX_MODE\"/" "$MINER_CONFIG/config.json" 2>/dev/null
        log "RANDOMX" "Configuração atualizada"
        
        if [ -f "$MINER_CONFIG/miner.pid" ]; then
            log "INFO" "Reinicie a mineração para aplicar as mudanças"
        fi
    fi
}

# ============================================================================
# FUNÇÃO 63: CONFIGURAR THREADS CPU
# ============================================================================
set_cpu_threads() {
    echo -e "\n${CYAN}Configuração de Threads CPU${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Núcleos disponíveis: $CPU_CORES"
    echo "Threads atuais: $CPU_THREADS"
    echo ""
    echo "Recomendações para Android:"
    echo "  • Deixe 1-2 núcleos livres para o sistema"
    echo "  • Não use todos os núcleos em dispositivos mais antigos"
    echo "  • Menos threads = menor consumo de bateria"
    echo ""
    read -p "Quantos threads usar? (1-$CPU_CORES): " threads
    
    if ! [[ "$threads" =~ ^[0-9]+$ ]] || [ "$threads" -lt 1 ] || [ "$threads" -gt "$CPU_CORES" ]; then
        log "ERROR" "Número inválido. Usando $CPU_CORES threads."
        threads=$CPU_CORES
    fi
    
    export CPU_THREADS=$threads
    local usage=$((threads * 100 / CPU_CORES))
    export CPU_MAX_USAGE=$usage
    
    log "CPU" "Threads configurados: $CPU_THREADS/$CPU_CORES (${usage}% de uso)"
    
    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"max-threads-hint\": [0-9]*/\"max-threads-hint\": $usage/" "$MINER_CONFIG/config.json" 2>/dev/null
        log "CPU" "Configuração atualizada"
    fi
}

# ============================================================================
# FUNÇÃO 64: CONFIGURAR PRIORIDADE CPU
# ============================================================================
set_cpu_priority() {
    echo -e "\n${CYAN}Configuração de Prioridade CPU${NC}"
    echo "═══════════════════════════════════════════════════"
    echo "Níveis de prioridade:"
    echo "   0) idle (mínima) - Só executa quando o sistema está ocioso"
    echo "   5) low (baixa)    - Prioridade baixa (recomendado para Android)"
    echo "  10) normal         - Prioridade normal"
    echo "  15) high (alta)    - Prioridade alta (pode afetar o sistema)"
    echo "  19) realtime       - Máxima prioridade (não recomendado)"
    echo ""
    echo "Prioridade atual: $CPU_PRIORITY"
    echo ""
    read -p "Escolha a prioridade (0-19): " priority
    
    if ! [[ "$priority" =~ ^[0-9]+$ ]] || [ "$priority" -lt 0 ] || [ "$priority" -gt 19 ]; then
        log "ERROR" "Prioridade inválida. Mantendo $CPU_PRIORITY."
        return
    fi
    
    export CPU_PRIORITY=$priority
    
    case $priority in
        0)  desc="idle (mínima)" ;;
        [1-4]) desc="baixa" ;;
        [5-9]) desc="média-baixa" ;;
        10) desc="normal" ;;
        [11-14]) desc="média-alta" ;;
        [15-18]) desc="alta" ;;
        19) desc="realtime (máxima)" ;;
    esac
    
    log "CPU" "Prioridade alterada para: $priority ($desc)"
    
    if [ -f "$MINER_CONFIG/config.json" ]; then
        sed -i "s/\"priority\": [0-9]*/\"priority\": $priority/" "$MINER_CONFIG/config.json" 2>/dev/null
        log "CPU" "Configuração atualizada"
    fi
}

